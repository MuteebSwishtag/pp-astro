---
const { active = false } = Astro.props;
const HeadingTag = active ? 'h1' : 'p';
---
<section class:list={["feature-workflow-panel","catalog-page"].concat(active ? ['is-active'] : [])} data-feature-panel="ChooseProduct" hidden={!active}>
<section class="catalog-hero feature-shell" aria-labelledby="catalog-title">
    <div class="catalog-hero-copy">
      <HeadingTag data-feature-heading class="feature-kicker" id="catalog-title">Search supplier catalogs. Start your mockup in one click.</HeadingTag>
      <h2 class="hero-title display-title">Find the right product. <span>Start designing instantly.</span></h2>
      <p class="feature-lede">Distributors can instantly search integrated supplier catalogs using vendor names, SKUs, or keywords—without downloading product images or manually rebuilding product data.</p>
      <div class="feature-actions"><a class="button button-dark" href="/contact">Talk to Sales <span>↗</span></a></div>
    </div>
    <div class="catalog-hero-visual" data-catalog-scene>
      <img src="/assets/features/catalog/catalog-hero-products.png" alt="A coordinated supplier catalog collection with a cap, bottle, tote, mug, and notebook">
      <form class="catalog-search-bar" role="search" onsubmit="return false">
        <span aria-hidden="true"></span>
        <label class="sr-only" for="catalog-query">Search products</label>
        <input id="catalog-query" type="text" value="Insulated bottle" aria-label="Search by vendor, SKU, or keyword">
        <kbd>⌘ K</kbd>
      </form>
      <div class="catalog-category-tabs" aria-label="Product categories">
        <button type="button" data-product="drinkware" class="is-active">Drinkware</button>
        <button type="button" data-product="apparel">Apparel</button>
        <button type="button" data-product="bags">Bags</button>
      </div>
      <article class="catalog-result-preview" aria-live="polite">
        <small>Selected product</small>
        <strong>Vacuum Bottle 24 oz.</strong>
        <span>SKU VB-240 · 12 colors</span>
        <i>Ready to design</i>
      </article>
    </div>
  </section>

  <section class="catalog-friction feature-shell">
    <div class="catalog-friction-heading">
      <p class="feature-kicker">Remove the setup work</p>
      <h2>Product setup should not begin with downloading images.</h2>
      <p>No more searching supplier websites, saving product photography, or manually uploading products into design software. Everything starts inside PromoPlus.</p>
    </div>
    <div class="catalog-old-new">
      <div class="old-way-list" aria-label="Old product setup workflow">
        <article><span>01</span><p>Search a supplier website</p><i>Open another tab</i></article>
        <article><span>02</span><p>Download product images</p><i>Save and rename</i></article>
        <article><span>03</span><p>Rebuild the product record</p><i>Copy the details</i></article>
      </div>
      <article class="catalog-one-step">
        <small>Inside PromoPlus</small>
        <strong>Search. Select. Start.</strong>
        <p>The product arrives with the information the team needs to begin the project.</p>
        <span>One connected start <i>↗</i></span>
      </article>
    </div>
  </section>

  <section class="catalog-search-story" id="catalog-search-story">
    <div class="feature-shell catalog-story-layout">
      <figure class="catalog-buyer-photo">
        <img src="/assets/features/catalog/catalog-search-buyer.png" alt="A promotional products buyer comparing catalog results with physical product samples">
        <figcaption><span>Search where the work begins</span><strong>Compare products and move the right one into the project.</strong></figcaption>
      </figure>
      <div class="catalog-story-copy">
        <p class="feature-kicker">How it works</p>
        <h2>From supplier catalog to active project.</h2>
        <p>Product discovery becomes the first connected step in the PromoPlus workflow.</p>
        <ol class="catalog-story-steps">
          <li class="is-active"><span>01</span><div><strong>Search the catalog</strong><p>Use a vendor name, SKU, or product keyword.</p></div></li>
          <li><span>02</span><div><strong>Select the product</strong><p>Keep standardized product information and imagery together.</p></div></li>
          <li><span>03</span><div><strong>Start designing</strong><p>Move directly into the mockup workflow without rebuilding the product.</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="catalog-outcome feature-shell">
    <div>
      <p class="feature-kicker">Customer outcome</p>
      <h2>Everything starts inside PromoPlus.</h2>
    </div>
    <div class="catalog-outcome-path" aria-label="Connected catalog outcome">
      <span>Supplier catalog</span><i>→</i><span>Selected product</span><i>→</i><strong>Ready to design</strong>
    </div>
  </section>

  <section class="related-features feature-shell">
    <div class="feature-section-heading"><p class="feature-kicker">Connected workflow</p><h2>The selected product is ready for what comes next.</h2></div>
    <div class="related-grid pp-related-pair">
      <a href="/features/online-mockup-designer"><small>Continue with</small><h3>Online Mockup Designer</h3><p>Place artwork and generate a customer-ready mockup.</p><span>Continue the workflow ↗</span></a>
      <a class="catalog-related-link" href="/features/centralized-project-workspace"><small>Keep the record in</small><h3>Centralized Project Workspace</h3><p>Connect the selected product, artwork, customer, and project history.</p><span>Explore the workspace ↗</span></a>
    </div>
  </section>

  <section class="feature-cta feature-shell" id="catalog-contact">
    <div class="pp-cta-copy"><p class="feature-kicker">Bring your supplier catalog</p><h2>Ready to find products without the manual setup?</h2></div>
    <a class="press-button" href="/contact">Talk to Sales <i>↗</i></a>
  </section>
</section>
