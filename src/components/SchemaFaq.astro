---
type FaqQuestion = {
  name: string;
  acceptedAnswer: { text: string };
};

const {
  faq,
  title,
  description,
  sectionId = 'faq',
  featureStep,
  hidden = false,
} = Astro.props as {
  faq: { mainEntity: FaqQuestion[] };
  title: string;
  description: string;
  sectionId?: string;
  featureStep?: string;
  hidden?: boolean;
};
const titleId = `${sectionId}-title`;
---

<section class="schema-faq" id={sectionId} aria-labelledby={titleId} data-schema-faq data-feature-faq={featureStep} hidden={hidden}>
  <div class="schema-faq-inner">
    <header class="schema-faq-heading">
      <p class="schema-faq-kicker">Frequently asked questions</p>
      <h2 id={titleId}>{title}</h2>
      <p>{description}</p>
    </header>
    <div class="schema-faq-list">
      {faq.mainEntity.map((entry, index) => (
        <details open={index === 0}>
          <summary>
            <span class="schema-faq-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{entry.name}</h3>
            <span class="schema-faq-toggle" aria-hidden="true">+</span>
          </summary>
          <p>{entry.acceptedAnswer.text}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .schema-faq { padding: clamp(72px, 8vw, 120px) 4vw; background: #f7f6ff; color: #29262f; }
  .schema-faq[hidden] { display: none; }
  .schema-faq-inner { width: min(100%, 1240px); margin: 0 auto; }
  .schema-faq-heading { max-width: 830px; margin-bottom: 42px; }
  .schema-faq-kicker { margin: 0 0 18px; color: #7159cc; font-size: 11px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
  .schema-faq-heading h2 { margin: 0; font-size: clamp(38px, 4.5vw, 68px); line-height: 1.02; letter-spacing: -.055em; font-weight: 550; }
  .schema-faq-heading > p:last-child { max-width: 630px; margin: 20px 0 0; color: #69656d; font-size: 16px; line-height: 1.6; }
  .schema-faq-list { display: grid; gap: 12px; }
  .schema-faq-list details { border: 1px solid rgba(58, 44, 92, .13); border-radius: 19px; background: rgba(255, 255, 255, .82); overflow: hidden; }
  .schema-faq-list summary { display: grid; grid-template-columns: 38px minmax(0, 1fr) 28px; align-items: center; gap: 16px; padding: 24px 26px; cursor: pointer; list-style: none; }
  .schema-faq-list summary::-webkit-details-marker { display: none; }
  .schema-faq-number { color: #775ed0; font-size: 11px; font-weight: 750; letter-spacing: .08em; }
  .schema-faq-list h3 { margin: 0; font-size: clamp(18px, 2vw, 27px); line-height: 1.2; letter-spacing: -.035em; font-weight: 600; }
  .schema-faq-toggle { color: #775ed0; font-size: 26px; line-height: 1; text-align: right; transition: transform .2s ease; }
  .schema-faq-list details[open] .schema-faq-toggle { transform: rotate(45deg); }
  .schema-faq-list details > p { max-width: 900px; margin: 0; padding: 0 72px 26px 80px; color: #625e67; font-size: 16px; line-height: 1.65; }
  .schema-faq-list summary:focus-visible { outline: 2px solid #775ed0; outline-offset: -4px; border-radius: 19px; }
  @media (max-width: 760px) {
    .schema-faq { padding: 70px 20px; }
    .schema-faq-list summary { grid-template-columns: 25px minmax(0, 1fr) 20px; gap: 10px; padding: 20px 16px; }
    .schema-faq-list details > p { padding: 0 45px 22px 51px; font-size: 14px; }
  }
</style>
