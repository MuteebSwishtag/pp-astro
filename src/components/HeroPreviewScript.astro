<script is:inline>
/* Hero preview only; no project data is submitted or modified. */
(() => {
  const hero = document.querySelector('#pp-hero');
  if (!hero) return;
  const q = s => hero.querySelector(s);
  const experience = q('.pp-experience');
  const tabs = [...hero.querySelectorAll('[role="tab"]')];
  const panels = [...hero.querySelectorAll('[data-for]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const titles = ['Your next project starts here.', 'Your artwork. On your product.', 'A little adjustment. A perfect fit.', 'One version. A clear yes.', 'Approved. Ready for production.'];
  let timer, approved = false, approvedAt = '', current = 0;
  const stamp = () => new Date().toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
  function approve() {
    clearTimeout(timer); approved = true; approvedAt = stamp();
    experience.classList.add('pp-resolved');
    q('#pp-comment').textContent = 'Logo placement updated';
    q('#pp-resolution').textContent = '✓ Resolved';
    q('#pp-approve').textContent = '✓ Approved'; q('#pp-approve').disabled = true;
    q('#pp-approved-time').textContent = 'Demo approval · ' + approvedAt;
    q('#pp-proof-time').textContent = approvedAt;
  }
  function invalidate() {
    approved = false; approvedAt = '';
    q('#pp-approve').textContent = 'Approve Version'; q('#pp-approve').disabled = false;
    q('#pp-approved-time').textContent = '';
  }
  function select(index) {
    clearTimeout(timer); current = index;
    experience.dataset.step = String(index);
    experience.classList.toggle('pp-resolved', index === 4 || (index === 3 && approved));
    tabs.forEach((t,i) => { t.setAttribute('aria-selected',String(i === index)); t.tabIndex = i === index ? 0 : -1; });
    panels.forEach(p => p.hidden = Number(p.dataset.for) !== index);
    q('#pp-stage').setAttribute('aria-labelledby',tabs[index].id);
    q('.pp-step-number').textContent = '0' + (index+1) + ' / 05';
    q('.pp-stage-title').textContent = titles[index];
    q('.pp-hint').textContent = index === 2 ? 'Try a logo color or adjust the artwork width.' : index === 3 ? 'Review the update, then approve this sample version.' : index === 4 ? 'The same product. The same artwork. Ready for the next team.' : 'One product. One connected project. Click a step to explore.';
    if (index === 3 && !approved) {
      q('#pp-comment').textContent = 'Move logo up'; q('#pp-resolution').textContent = 'Updating placement…';
      const resolve = () => { experience.classList.add('pp-resolved'); q('#pp-resolution').textContent = '✓ Resolved'; };
      if (reduced.matches) resolve(); else timer = setTimeout(resolve,1100);
    }
    if (index === 4 && !approved) approve();
  }
  tabs.forEach((tab,i) => {
    tab.addEventListener('click',() => select(i));
    tab.addEventListener('keydown',e => {
      let next;
      if(e.key === 'ArrowRight') next = (i+1)%5;
      if(e.key === 'ArrowLeft') next = (i+4)%5;
      if(e.key === 'Home') next = 0;
      if(e.key === 'End') next = 4;
      if(next !== undefined){e.preventDefault();select(next);tabs[next].focus();}
    });
  });
  q('#pp-place').addEventListener('click',() => { const art=q('.pp-artwork'); art.style.animation='none'; void art.offsetWidth; art.style.animation=''; });
  hero.querySelectorAll('[data-color]').forEach(button => button.addEventListener('click',() => {
    experience.style.setProperty('--art-color',button.dataset.color);
    hero.querySelectorAll('[data-color]').forEach(b => b.setAttribute('aria-pressed',String(b===button)));
    invalidate();
  }));
  q('#pp-width').addEventListener('input',e => {
    const value = Number(e.target.value);
    experience.style.setProperty('--art-scale',value/18);
    q('#pp-width-label').textContent=value+' cm';q('#pp-proof-width').textContent=value+' cm';invalidate();
  });
  q('#pp-approve').addEventListener('click',approve);
  q('.pp-stage').addEventListener('pointermove',e => {
    if(reduced.matches || e.pointerType!=='mouse' || current!==0) return;
    const r=e.currentTarget.getBoundingClientRect();
    experience.style.setProperty('--px',((e.clientX-r.left)/r.width-.5)*5+'px');
    experience.style.setProperty('--py',((e.clientY-r.top)/r.height-.5)*5+'px');
  },{passive:true});
  q('.pp-stage').addEventListener('pointerleave',() => {experience.style.setProperty('--px','0px');experience.style.setProperty('--py','0px');});
  q('#pp-download').addEventListener('click',async () => {
    const button=q('#pp-download');button.disabled=true;button.textContent='Preparing PDF…';
    try {
      // Rasterize this existing product photo plus the current artwork into a small,
      // dependency-free PDF. This is an explicitly labeled demonstration proof.
      const source=new Image();source.src="/assets/promoplus/sample-proof-product.png";await source.decode();
      const canvas=document.createElement('canvas');canvas.width=900;canvas.height=1200;
      const c=canvas.getContext('2d');c.fillStyle='#fff';c.fillRect(0,0,900,1200);
      await document.fonts.ready;
      c.fillStyle='#211f24';c.font='bold 36px "Plus Jakarta Sans"';c.fillText('PromoPlus',60,75);
      c.font='16px "Plus Jakarta Sans"';c.fillText('PRODUCTION PROOF / SAMPLE PROJECT',60,110);
      c.drawImage(source,250,155,400,300);
      c.fillStyle=getComputedStyle(experience).getPropertyValue('--art-color').trim();
      const scale=Number(q('#pp-width').value)/18;
      c.textAlign='center';c.font='bold '+(21*scale)+'px "Plus Jakarta Sans"';c.fillText('PromoPlus',450,290);
      c.font=(5*scale)+'px "Plus Jakarta Sans"';c.fillText('MADE TOGETHER.',450,300);c.textAlign='left';
      c.fillStyle='#211f24';c.font='bold 25px "Plus Jakarta Sans"';c.fillText('Everyday Hoodie / Sage',60,520);
      c.font='18px "Plus Jakarta Sans"';
      ['Decoration: Front center','Artwork: promoplus-logo.svg','Print method: Screen print','Artwork width: '+q('#pp-width').value+' cm','Version: 3','Status: Approved (demo)','Timestamp: '+approvedAt,'Sample preview only. Not a production-ready artwork file.'].forEach((t,i)=>c.fillText(t,60,575+i*48));
      const binary=atob(canvas.toDataURL('image/jpeg',.92).split(',')[1]);
      const jpeg=Uint8Array.from(binary,x=>x.charCodeAt(0));
      const enc=new TextEncoder(),parts=[],offsets=[0];let length=0;
      const append=data=>{const bytes=typeof data==='string'?enc.encode(data):data;parts.push(bytes);length+=bytes.length;};
      const obj=(n,data)=>{offsets[n]=length;append(n+' 0 obj\n'+data+'\nendobj\n');};
      append('%PDF-1.4\n');obj(1,'<< /Type /Catalog /Pages 2 0 R >>');obj(2,'<< /Type /Pages /Kids [3 0 R] /Count 1 >>');
      obj(3,'<< /Type /Page /Parent 2 0 R /MediaBox [0 0 600 800] /Resources << /XObject << /Im 4 0 R >> >> /Contents 5 0 R >>');
      offsets[4]=length;append('4 0 obj\n<< /Type /XObject /Subtype /Image /Width 900 /Height 1200 /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length '+jpeg.length+' >>\nstream\n');append(jpeg);append('\nendstream\nendobj\n');
      const stream='q 600 0 0 800 0 0 cm /Im Do Q';obj(5,'<< /Length '+stream.length+' >>\nstream\n'+stream+'\nendstream');
      const xref=length;append('xref\n0 6\n0000000000 65535 f \n');offsets.slice(1).forEach(n=>append(String(n).padStart(10,'0')+' 00000 n \n'));append('trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n'+xref+'\n%%EOF');
      const url=URL.createObjectURL(new Blob(parts,{type:'application/pdf'}));const link=document.createElement('a');link.href=url;link.download='PromoPlus-sample-production-proof.pdf';link.click();setTimeout(()=>URL.revokeObjectURL(url),10000);
    } catch(error) {q('.pp-hint').textContent='PDF preview needs a local web server. Please open the site through your development server and try again.';}
    finally {button.disabled=false;button.textContent='Download PDF ↓';}
  });
})();
</script>

