      <section class="section-shell stack-section" aria-labelledby="stack-title" hidden aria-hidden="true" style="display:none">
        <div class="section-intro compact-intro"><div><h2 id="stack-title">Every version<br><span class="heading-accent accent-green">stays clear.</span></h2></div><p>PromoPlus keeps versions, comments, sides, and approvals organized so the team knows exactly what is final.</p></div>
        <div class="version-control-layout">
          <div class="card-stack version-stack" tabindex="0" aria-label="Hover to compare artwork versions">
            <article class="stack-card stack-one approved-version real-version-card" tabindex="0" data-cursor-kind="version" data-cursor-label="COMPARE" data-version="Approved Version" data-detail="Timestamped, locked, and ready to send into production."><img src="/assets/promoplus/client-preview.png" alt="Approved client preview"></article>
            <article class="stack-card stack-two real-version-card" tabindex="0" data-cursor-kind="version" data-cursor-label="COMPARE" data-version="Version 3" data-detail="Updated placement for the requested logo position."><img src="/assets/promoplus/preview-version.png" alt="Artwork version three"></article>
            <article class="stack-card stack-three old-version real-version-card" tabindex="0" data-cursor-kind="version" data-cursor-label="COMPARE" data-version="Version 2" data-detail="Front approved, but the sleeve is still pending feedback."><img src="/assets/promoplus/preview-feedback.png" alt="Artwork feedback review"></article>
            <article class="stack-card stack-four old-version real-version-card" tabindex="0" data-cursor-kind="version" data-cursor-label="COMPARE" data-version="Version 1" data-detail="Client requested a logo size change before approval."><img src="/assets/promoplus/design-editor.png" alt="Initial artwork editor version"></article>
          </div>
          <aside class="version-details"><p class="eyebrow">Selected version</p><h3>Approved Version</h3><p>Timestamped, locked, and ready to send into production.</p><span>Hover a version to compare</span></aside>
        </div>
      </section>

      

      

      

      



      

      <section class="faq-section section-shell" id="faq" aria-labelledby="faq-title">
        <div class="faq-intro">
          <p class="eyebrow">Frequently asked questions</p>
          <h2 class="section-title" id="faq-title">Questions, answered before production starts.</h2>
          <p>Quick answers about product setup, artwork, approvals, and the final handoff.</p>
        </div>
        <div class="faq-list">
          {homeFaqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <summary data-cursor-kind={['dashboard', 'dashboard', 'approval', 'version', 'dashboard'][index]} data-cursor-label="OPEN"><span>{String(index + 1).padStart(2, '0')}</span><strong>{question}</strong></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="cta-section section-shell" id="contact" aria-labelledby="cta-title">
        <div class="cta-panel">
          <div class="cta-orbit" aria-hidden="true">
            <span class="cta-orbit-label label-artwork">Artwork</span>
            <span class="cta-orbit-label label-mockup">Mockup</span>
            <span class="cta-orbit-label label-approval">Approval</span>
            <span class="cta-orbit-label label-pdf">PDF</span>
          </div>
          <div class="cta-copy">
            <h2 id="cta-title">Ready to make<br><em>approvals easier?</em></h2>
            <p>Give your team one clean place to create mockups, collect feedback, manage versions, and send approved files to production.</p>
            <div class="cta-actions">
              <a class="press-button magnetic" data-cursor-kind="cta" data-cursor-label="START" href="/contact"><span>Talk to Sales</span><i aria-hidden="true">↗</i></a>
              <a class="cta-secondary" href="/features"><span>Explore Features</span><i aria-hidden="true">↓</i></a>
            </div>
          </div>
        </div>
      </section>
