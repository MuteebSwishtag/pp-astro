import { homeFaqs } from '../data/homeFaqs';
---
<section class="pp-hero" aria-labelledby="hero-title" id="pp-hero">
  <div class="pp-hero-layout">
<div class="pp-heading">
    <h1 class="pp-eyebrow" id="hero-title">PROMOPLUS FOR PROMOTIONAL PRODUCT TEAMS</h1>
    <h2>From Mockup to Production.<br><span>Faster.</span></h2>
    <p class="pp-description">Create product mockups, collect client approvals, and prepare production-ready files in one connected workspace.</p>
    <a class="pp-cta" href="https://app.promoplus.io" target="_blank">Try it Free <span aria-hidden="true">↗</span></a>
  </div>
<div class="pp-hero-visual" role="img" aria-label="PromoPlus mockup workspace showing a woman in a cream hoodie, with client review and feedback screens">
      <span class="pp-hero-glow" aria-hidden="true"></span>
      <img class="pp-hero-review" src="/assets/promoplus/client-review-hd-v2.png" alt="" aria-hidden="true">
      <img class="pp-hero-editor" src="/assets/promoplus/hero-mockup-v2.png" alt="" aria-hidden="true" fetchpriority="high">
      <img class="pp-hero-feedback" src="/assets/promoplus/preview-feedback.png" alt="" aria-hidden="true">
    </div>
  </div>
  <section class="story-problem" aria-labelledby="story-problem-title">
    <div class="story-problem-heading">
      <div><p class="story-kicker">The real problem</p><h2 id="story-problem-title">The mockup isn’t the hard part. Keeping everyone aligned is.</h2></div>
      <p>Once feedback starts, files split across messages, versions lose context, and production is left asking what is actually final.</p>
    </div>
    <ul class="story-problem-list">
      <li><span>01</span><strong>Feedback gets scattered</strong><p>Comments arrive through email, messages, and separate files.</p></li>
      <li><span>02</span><strong>Versions become unclear</strong><p>Clients and teams can easily review an outdated mockup.</p></li>
      <li><span>03</span><strong>Production has to guess</strong><p>The approved artwork and product details do not arrive together.</p></li>
    </ul>
  </section>
  <header class="story-workflow-intro" aria-labelledby="story-workflow-title">
    <p class="story-kicker">The PromoPlus workflow</p>
    <h2 id="story-workflow-title">One workflow. From product to production.</h2>
    <p>Choose a product, build the mockup, collect clear feedback, secure approval, and hand off the final file—with every step connected.</p>
  </header>
  <div class="pp-story">
    <div class="pp-story-header"><img class="pp-workflow-logo" src="/favicon.svg" alt="PromoPlus" width="44" height="44"><span class="pp-story-divider"></span><span>Product workflow</span><span class="pp-story-counter" id="pp-story-counter">01 / 05</span></div>
    <div class="pp-story-body" id="pp-story-panel" role="tabpanel" aria-labelledby="pp-tab-0" tabindex="0">
      <div class="pp-story-copy">
        <span class="pp-story-eyebrow" id="pp-story-eyebrow">01 · PRODUCT LIBRARY</span>
        <h2 id="pp-story-title">Choose the product you want to make yours.</h2>
        <p id="pp-story-description">Browse product views in the library and select the mockup that fits your project.</p>
        <div class="pp-story-proof"><span class="pp-story-proof-dot"></span><span id="pp-story-proof">Product views live beside the workspace.</span></div><a class="pp-story-download" hidden href="/assets/promoplus/sample-production-proof.pdf" download="proof.pdf">Download production PDF <span aria-hidden="true">↓</span></a>
        <div class="pp-story-controls"><button type="button" id="pp-story-prev" aria-label="Previous step">←</button><button type="button" id="pp-story-next" aria-label="Next step">→</button></div>
      </div>
      <div class="pp-story-visual"><div class="pp-story-image-wrap"><img id="pp-story-image" src="/assets/people/choose-products-v2.png" alt="PromoPlus product library showing a model in the selected warm-white hoodie" width="1566" height="1004"><div class="pp-production-preview" hidden aria-label="Complete pages of the production PDF">
      <figure><figcaption>01 / Product proof</figcaption><img src="/assets/promoplus/sample-production-proof-page-1.png" alt="Complete product proof page from the supplied PDF"></figure>
      <figure><figcaption>02 / Artwork inspection</figcaption><img src="/assets/promoplus/sample-production-proof-page-2.png" alt="Complete artwork inspection page from the supplied PDF"></figure>
    </div></div><span class="pp-story-image-label" id="pp-story-image-label">APPLICATION CAPTURE</span></div>
    </div>
    <div class="pp-navigation" role="tablist" aria-label="Explore the PromoPlus workflow">
      <button type="button" role="tab" id="pp-tab-0" aria-controls="pp-story-panel" aria-selected="true" tabindex="0"><span>01</span>Choose Products</button>
      <button type="button" role="tab" id="pp-tab-1" aria-controls="pp-story-panel" aria-selected="false" tabindex="-1"><span>02</span>Create Mockups</button>
      <button type="button" role="tab" id="pp-tab-2" aria-controls="pp-story-panel" aria-selected="false" tabindex="-1"><span>03</span>Edit Artwork</button>
      <button type="button" role="tab" id="pp-tab-3" aria-controls="pp-story-panel" aria-selected="false" tabindex="-1"><span>04</span>Get Approval</button>
      <button type="button" role="tab" id="pp-tab-4" aria-controls="pp-story-panel" aria-selected="false" tabindex="-1"><span>05</span>Production Files</button>
    </div>
    <p class="pp-story-note">Explore the flow using PromoPlus application captures and product design references.</p>
  </div>
</section>

      <section class="pc-credibility" aria-labelledby="trust-title">
