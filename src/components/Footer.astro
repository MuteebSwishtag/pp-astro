---
const { top = '#top' } = Astro.props;
---
<footer class="site-footer">
  <span class="site-footer-brand">
    <img src="/favicon.svg" alt="PromoPlus" width="66" height="66" />
    <small>© 2026 PromoPlus</small>
  </span>
  <span>Product approvals, made clear</span>
  <a class="text-link" href={top}>Back to top ↑</a>
</footer>

<style>
  :root {
    --brand-plum: #352b6a;
    --brand-white: #fff;
  }

  .site-footer {
    width: 100%;
    max-width: none;
    margin: 0;
    min-height: 112px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px max(4vw, calc((100vw - 1340px) / 2));
    border-top: 0;
    background: var(--brand-plum);
    color: var(--brand-white);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 12px;
    line-height: 1.4;
  }

  .site-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
  }

  .site-footer-brand img {
    display: block;
    width: 66px;
    height: 66px;
    object-fit: contain;
  }

  .site-footer-brand small {
    color: #edeaff;
    font-size: 11px;
  }

  .site-footer a,
  .site-footer a:hover {
    color: var(--brand-white);
    text-decoration: none;
    font-size: 12px;
    font-weight: 650;
  }

  @media (max-width: 600px) {
    .site-footer {
      align-items: flex-start;
      padding: 22px 20px 86px;
      flex-direction: column;
    }

    .site-footer-brand img {
      width: 58px;
      height: 58px;
    }
  }
</style>

