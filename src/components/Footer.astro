---
const { variant = 'default', label = 'Product approvals, made clear', top = '#top' } = Astro.props;
---
<footer class:list={['site-footer', variant === 'feature' && 'feature-footer']}>
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-logo" href="/index.html" aria-label="PromoPlus home">Promo<span>Plus</span></a>
      <p>{label}</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href="/features/product-catalog-integration.html">Features</a>
      <a href="/features/index.html">Insights</a>
      <a href="/pricing.html">Pricing</a>
      <a href="/pricing.html#custom-plan-form">Custom Plan</a>
    </nav>
    <div class="footer-meta">
      <span>© 2026 PromoPlus</span>
      <a href={top}>Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(203, 185, 255, .14);
    background: #211f24;
    color: #f7f6f2;
    font-family: "Plus Jakarta Sans", sans-serif;
    line-height: 1.4;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) auto minmax(180px, .7fr);
    align-items: center;
    gap: 30px;
    width: min(100%, 1500px);
    margin: 0 auto;
    padding: 34px max(24px, 5vw);
  }

  .footer-brand {
    display: grid;
    gap: 8px;
  }

  .footer-logo {
    width: max-content;
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -.04em;
  }

  .footer-logo span {
    color: #cbb9ff;
  }

  .footer-brand p,
  .footer-meta span {
    margin: 0;
    color: #aba4b4;
    font-size: 11px;
  }

  .footer-links,
  .footer-meta {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .footer-links {
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer-meta {
    justify-content: flex-end;
  }

  .site-footer a {
    color: #f7f6f2;
    text-decoration: none;
    font-size: 12px;
    font-weight: 650;
    transition: color .2s ease;
  }

  .site-footer a:hover {
    color: #cbb9ff;
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 22px;
      text-align: center;
      padding: 30px 20px calc(34px + env(safe-area-inset-bottom));
    }

    .footer-brand,
    .footer-links,
    .footer-meta {
      justify-items: center;
      justify-content: center;
      width: 100%;
    }

    .footer-logo {
      margin: 0 auto;
    }

    .footer-meta {
      flex-direction: column;
      gap: 9px;
    }
  }
</style>

