---
const exploreLinks = [
  { label: 'Features', href: '/features/' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Insights', href: '/insights/' },
];

const industryLinks = [
  { label: 'Distributors', href: '/industries/promotional-products-distributor-software' },
  { label: 'Suppliers', href: '/industries/promotional-products-supplier-software' },
  { label: 'Decorators', href: '/industries/promotional-products-decorator-software' },
];

const socialLinks = [
  { label: 'X', href: 'https://x.com/helloswishtag', icon: 'x' },
  { label: 'YouTube', href: 'https://www.youtube.com/@helloswishtag', icon: 'youtube' },
  { label: 'Pinterest', href: 'https://www.pinterest.com/helloswishtag/', icon: 'pinterest' },
  { label: 'Facebook', href: 'https://www.facebook.com/helloswishtag', icon: 'facebook' },
  { label: 'Instagram', href: 'https://www.instagram.com/helloswishtag/', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/helloswishtag', icon: 'linkedin' },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label="PromoPlus home">
          <img src="/favicon-black.svg" alt="" width="112" height="112" />
        </a>
        <p>Promotional product mockups, approvals, and production files in one connected workspace.</p>
      </div>

      <nav class="footer-column" aria-label="Explore PromoPlus">
        <h2>Explore</h2>
        {exploreLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      </nav>

      <nav class="footer-column" aria-label="Solutions by industry">
        <h2>Solutions</h2>
        {industryLinks.map(({ label, href }) => <a href={href}>{label}</a>)}
      </nav>

      <div class="footer-connect">
        <h2>Get in touch</h2>
        <a class="footer-cta" href="/contact">Talk to our team <span aria-hidden="true">↗</span></a>
        <address>
          90 State St Ste 700 Office 40<br />
          Albany, NY 12207, United States<br />
          <a href="tel:+15186501201">+1 518-650-1201</a>
        </address>
        <nav class="footer-socials" aria-label="Swishtag social media">
          {socialLinks.map(({ label, href, icon }) => (
            <a href={href} aria-label={`Swishtag on ${label}`} title={label} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                {icon === 'x' && <path d="M4 3h3.5L20 21h-3.5L4 3Zm0 18 7.4-8.5M20 3l-7.4 8.5" />}
                {icon === 'youtube' && <><rect x="2.5" y="5" width="19" height="14" rx="4" /><path d="m10 9 5 3-5 3V9Z" class="icon-fill" /></>}
                {icon === 'pinterest' && <><circle cx="12" cy="12" r="9" /><path d="m9.5 19 1.5-6.7c-.4-.7-.6-1.5-.6-2.2 0-1.8 1-3 2.2-3 1.1 0 1.8.8 1.8 1.9 0 1.3-.9 3.5-.9 4.6 0 1 .6 1.7 1.6 1.7 2.1 0 3.7-2.2 3.7-5.2 0-2.9-2.2-4.9-5.3-4.9-3.5 0-5.8 2.4-5.8 5.4 0 1.2.4 2.3 1.1 3" /></>}
                {icon === 'facebook' && <path d="M14.7 21v-8h2.7l.4-3.1h-3.1V8c0-.9.3-1.4 1.5-1.4h1.7V3.8a22 22 0 0 0-2.5-.2c-2.7 0-4.4 1.6-4.4 4.5v1.8H8.5V13H11v8" />}
                {icon === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.7" r="1" class="icon-fill" /></>}
                {icon === 'linkedin' && <><path d="M4.5 10v10M4.5 5.2v.1M9.5 20V10h3v1.5c.8-1.2 1.8-1.8 3.3-1.8 2.5 0 3.7 1.6 3.7 4.1V20M12.5 14c0-1.1.8-2 2-2 1.3 0 2 .9 2 2.3V20" /></>}
              </svg>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <small>© {new Date().getFullYear()} PromoPlus</small>
      <small>A Swishtag product</small>
    </div>
  </div>
</footer>

<style>
  html body footer.site-footer {
    display: block !important;
    width: 100%;
    max-width: none;
    min-height: 0;
    margin: 0;
    padding: 0 !important;
    border-top: 1px solid var(--pp-line) !important;
    background: var(--pp-paper) !important;
    color: var(--pp-ink) !important;
    text-align: left;
    font-family: var(--pp-font);
    font-size: 14px;
    line-height: 1.45;
  }

  .footer-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: clamp(64px, 6vw, 88px) clamp(24px, 5vw, 72px) 28px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(220px, 1.45fr) repeat(2, minmax(130px, .75fr)) minmax(250px, 1.25fr);
    gap: clamp(28px, 4.4vw, 72px);
    padding-bottom: clamp(60px, 6vw, 84px);
  }

  .footer-brand {
    max-width: 265px;
  }

  html body footer.site-footer .footer-logo {
    display: block;
    width: 112px;
    margin-left: -10px;
  }

  .footer-logo img {
    display: block;
    width: 112px;
    height: 112px;
  }

  .footer-brand p {
    margin: 10px 0 0;
    color: var(--pp-muted);
    font-size: 14px;
    line-height: 1.65;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
    min-width: 0;
  }

  .footer-column h2,
  .footer-connect h2 {
    margin: 3px 0 12px;
    color: var(--pp-ink);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  html body footer.site-footer .footer-column a {
    color: var(--pp-muted) !important;
    font-size: 14px;
    font-weight: 450;
    line-height: 1.4;
  }

  .footer-connect {
    min-width: 0;
  }

  .footer-connect h2 {
    margin-bottom: 23px;
  }

  html body footer.site-footer .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--pp-ink) !important;
    font-size: 14px;
    font-weight: 750;
    text-decoration: underline;
    text-decoration-color: var(--pp-primary);
    text-underline-offset: 5px;
  }

  .footer-cta span {
    color: var(--pp-primary);
  }

  .footer-connect address {
    margin: 23px 0 24px;
    color: var(--pp-muted);
    font-size: 13px;
    font-style: normal;
    line-height: 1.7;
  }

  html body footer.site-footer .footer-connect address a {
    display: inline-block;
    margin-top: 7px;
    color: var(--pp-muted) !important;
    white-space: nowrap;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  html body footer.site-footer .footer-socials a {
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border: 1px solid var(--pp-line);
    border-radius: 50%;
    color: var(--pp-ink) !important;
    transition: color .2s ease, background-color .2s ease, border-color .2s ease, transform .2s ease;
  }

  .footer-socials svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .footer-socials .icon-fill {
    fill: currentColor;
    stroke: none;
  }

  html body footer.site-footer .footer-socials a:hover {
    transform: translateY(-2px);
    border-color: var(--pp-primary);
    background: var(--pp-primary);
    color: #fff !important;
  }

  html body footer.site-footer a:hover {
    color: var(--pp-primary-dark) !important;
  }

  html body footer.site-footer a:focus-visible {
    outline: 3px solid var(--pp-primary);
    outline-offset: 5px;
    border-radius: 2px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--pp-line);
  }

  .footer-bottom small {
    color: var(--pp-muted);
    font-size: 12px;
    line-height: 1.4;
  }

  @media (max-width: 960px) {
    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 48px;
      row-gap: 50px;
    }
  }

  @media (max-width: 600px) {
    .footer-inner {
      padding: 60px 24px 32px;
    }

    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
      row-gap: 44px;
      padding-bottom: 56px;
    }

    .footer-brand,
    .footer-connect {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
</style>
