---
import '../styles/legacy/navigation.css';
const { active = '', announcement = false } = Astro.props;
type FeatureLink = [number: string, label: string, href: string, desc: string];
type FeatureGroup = [group: string, links: FeatureLink[]];

const featureLinks: FeatureGroup[] = [
  ['Create', [
    ['01', 'Choose Product', '/features/product-catalog-integration', 'Find the right supplier product for the project.'],
    ['02', 'Create Mockup', '/features/online-mockup-designer', 'Place artwork and build the customer proof.'],
    ['03', 'Revise Artwork', '/features/artwork-version-control', 'Keep every change tied to the right version.'],
  ]],
  ['Align', [
    ['04', 'Approve Design', '/features/customer-approval-portal', 'Give the client one clear version to decide on.'],
    ['05', 'Organize Project', '/features/centralized-project-workspace', 'Keep products, files, notes, and decisions together.'],
    ['06', 'Collaborate', '/features/team-collaboration', 'Give every role the same project context.'],
  ]],
  ['Deliver', [
    ['07', 'Monitor Progress', '/features/workflow-progress-dashboard', 'See what is moving, waiting, and blocked.'],
    ['08', 'Produce Files', '/features/production-ready-file-generation', 'Send the approved proof and artwork forward.'],
  ]],
];
---
{announcement && <div class="pn-announcement"><span>From mockup to production, all in one place.</span><a class="pn-announcement-link" data-nav-route="signup" data-cro-event="announcement_signup_click" href="https://app.promoplus.io/signup">Sign up <span aria-hidden="true">→</span></a></div>}
<header class="pn-header" data-cursor-theme="light">
  <div class="pn-bar">
    <a class="pn-logo" href="/" aria-label="PromoPlus home">
      <svg class="pn-logo-svg" viewBox="600 600 1750 1750" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="pn-logo-frame-gradient" x1="1483.62" y1="701.023" x2="1483.62" y2="2119" gradientUnits="userSpaceOnUse">
            <stop stop-color="#04C4DB" />
            <stop offset="1" stop-color="#4E5FE1" />
          </linearGradient>
          <linearGradient id="pn-logo-mark-gradient-a" x1="1960" y1="842" x2="1960" y2="1086" gradientUnits="userSpaceOnUse">
            <stop stop-color="#355DFA" />
            <stop offset="1" stop-color="#681FFC" />
          </linearGradient>
          <linearGradient id="pn-logo-mark-gradient-b" x1="2111" y1="935" x2="2111" y2="1179" gradientUnits="userSpaceOnUse">
            <stop stop-color="#355DFA" />
            <stop offset="1" stop-color="#681FFC" />
          </linearGradient>
        </defs>
        <path
          class="pn-logo-frame"
          d="M 757.131 793.655 Q 757.131 683.523 867.263 683.523 H 2099.979 Q 2210.111 683.523 2210.111 793.655 V 2026.371 Q 2210.111 2136.503 2099.979 2136.503 H 867.263 Q 757.131 2136.503 757.131 2026.371 V 793.655 Z"
          stroke="url(#pn-logo-frame-gradient)"
          stroke-width="46"
          fill="none"
          pathLength="1"
        />
        <g class="pn-logo-mark">
          <rect x="1931" y="842" width="58" height="244" rx="10" fill="url(#pn-logo-mark-gradient-a)" />
          <rect x="2082" y="935" width="58" height="244" rx="10" transform="rotate(90 2082 935)" fill="url(#pn-logo-mark-gradient-b)" />
        </g>
        <g class="pn-logo-text">
          <text class="pn-logo-word pn-logo-word-one" x="850" y="1632">Promo</text>
          <text class="pn-logo-word pn-logo-word-two" x="850" y="1952">Plus</text>
          <text class="pn-logo-tagline" x="860" y="2250">From mockup to Production. Faster.</text>
        </g>
      </svg>
    </a>
    <nav class="pn-navigation" id="pn-navigation" aria-label="Main navigation">
      <div class="pn-menu-group">
        <button type="button" class="pn-trigger" id="pn-product-trigger" aria-controls="pn-product-panel" aria-expanded="false" data-cro-event="nav_features_open">Features<svg class="pn-chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <div class="pn-panel pn-product-panel" id="pn-product-panel" aria-labelledby="pn-product-trigger" hidden>
          {featureLinks.map(([group, links]) => <div class="pn-column"><h2>{group}</h2>{links.map(([number, label, href, desc]) => <a class="pn-item" href={href} data-cro-event="nav_feature_click" data-nav-group="product" data-nav-feature={label}><span class="pn-item-icon pn-item-number" aria-hidden="true">{number}</span><span><b>{label}</b><small>{desc}</small></span></a>)}</div>)}
        </div>
      </div>
      <a class:list={["pn-pricing", active === 'insights' && 'is-active']} data-nav-route="insights" data-cro-event="nav_insights_click" href="/insights/">Insights</a>
      <a class:list={["pn-pricing", active === 'pricing' && 'is-active']} data-nav-route="pricing" data-cro-event="nav_pricing_click" href="/pricing">Pricing</a>
      <a class="pn-mobile-auth" data-nav-route="login" data-cro-event="nav_login_click" href="https://app.promoplus.io/login" target="_blank" >Login</a>
      <a class="pn-mobile-auth pn-mobile-auth-primary" data-nav-route="signup" data-cro-event="nav_signup_click" href="https://app.promoplus.io/signup" target="_blank" >Sign Up <span aria-hidden="true">↗</span></a>
    </nav>
    <div class="pn-actions">
      <a class="pn-secondary" data-nav-route="login" data-cro-event="nav_login_click" href="https://app.promoplus.io/login" target="_blank" >Login</a>
      <a class="pn-primary" data-nav-route="signup" data-cro-event="nav_signup_click" href="https://app.promoplus.io/signup" target="_blank" >Sign Up <span aria-hidden="true">↗</span></a>
    </div>
    <button type="button" class="pn-mobile-toggle" aria-label="Open navigation" aria-controls="pn-navigation" aria-expanded="false"><span class="pn-menu-lines" aria-hidden="true"></span><span class="pn-mobile-label">Menu</span></button>
  </div>
</header>
<script is:inline src="/navigation.js"></script>

