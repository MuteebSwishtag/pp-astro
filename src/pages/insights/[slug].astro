---
import PostPage from '../post.astro';

export async function getStaticPaths() {
  const API_URL = 'https://dei.bcv.mybluehost.me/website_27c75ff3/wp-json/wp/v2/posts';
  const fallbackSlugs = [
    'from-artwork-to-production-a-better-promotional-product-proofing-workflow',
    'how-promotional-product-mockup-software-speeds-up-client-approvals',
    'what-is-an-artwork-proof-in-promotional-products',
  ];
  let slugs = fallbackSlugs;

  try {
    const fetchedSlugs = [];
    let totalPages = 1;

    for (let page = 1; page <= totalPages; page += 1) {
      const url = new URL(API_URL);
      url.searchParams.set('per_page', '100');
      url.searchParams.set('page', String(page));
      url.searchParams.set('_fields', 'slug');

      const signal = AbortSignal.timeout?.(5000);
      const response = await fetch(url, { headers: { Accept: 'application/json' }, signal });
      if (!response.ok) break;

      totalPages = Number(response.headers.get('x-wp-totalpages') || totalPages);
      const posts = await response.json();
      if (!Array.isArray(posts) || !posts.length) break;

      fetchedSlugs.push(...posts.map((post) => post?.slug).filter(Boolean));
    }

    if (fetchedSlugs.length) {
      slugs = fetchedSlugs;
    }
  } catch {
    slugs = fallbackSlugs;
  }

  return [...new Set(slugs)].map((slug) => ({ params: { slug } }));
}
---
<PostPage />
