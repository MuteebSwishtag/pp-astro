---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/overview-pages.css';

const industries = [
  {
    number: '01',
    role: 'Distributors',
    title: 'Keep client approvals moving.',
    text: 'Create the product mockup, capture the client decision, and hand off a clear approved proof to the next team.',
    href: '/industries/promotional-products-distributor-software',
    image: '/assets/overview/industries/distributor-handoff.webp',
    alt: 'Distributor and account team reviewing an approved promotional product handoff',
    tags: ['Client approval', 'Mockup review', 'Clean handoff'],
    link: 'Explore distributor software',
  },
  {
    number: '02',
    role: 'Suppliers',
    title: 'Standardize incoming jobs.',
    text: 'Receive the product, artwork, imprint details, and approval record in one consistent workflow your team can trust.',
    href: '/industries/promotional-products-supplier-software',
    image: '/assets/overview/industries/supplier-spec-check.webp',
    alt: 'Supplier team checking a decorated product and its specifications',
    tags: ['Product specs', 'Approval record', 'Order clarity'],
    link: 'Explore supplier software',
  },
  {
    number: '03',
    role: 'Decorators',
    title: 'Start every job with clarity.',
    text: 'Receive the approved artwork, placement, imprint size, and colors in one predictable proof before production begins.',
    href: '/industries/promotional-products-decorator-software',
    image: '/assets/overview/industries/decorator-production-proof.webp',
    alt: 'Production proof and decorated garment prepared for the decorator',
    tags: ['Approved artwork', 'Imprint details', 'Ready to run'],
    link: 'Explore decorator software',
  },
];

const connections = [
  ['Distributor', "Builds the mockup and collects the client's exact decision."],
  ['Supplier', 'Receives consistent product, artwork, imprint, and color information.'],
  ['Decorator', 'Starts production from the approved version and confirmed details.'],
];
---

<BaseLayout
  title="Industries | PromoPlus"
  description="PromoPlus for promotional product distributors, suppliers, and decorators who need clearer mockups, approvals, and production-ready proofs."
  bodyClass="overview-page industry-overview-page"
>
  <Header active="industries" />
  <main id="main-content">
    <section class="overview-hero industries-home">
      <div class="overview-hero-copy">
        <p class="overview-kicker">PromoPlus Industries</p>
        <h1>Distributors, suppliers, and decorators <strong>connected by <span class="industry-accent">one approval workflow.</span></strong></h1>
        <p>PromoPlus gives every team touching the order the same clear product, artwork, approval, and production context.</p>
        <div class="overview-actions">
          <a class="overview-primary" href="#industry-list">Explore Industries <span aria-hidden="true">-&gt;</span></a>
          <a class="overview-secondary" href="/pricing#custom-plan-form">Book a Demo <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
      <div class="overview-hero-visual">
        <div class="overview-hero-frame">
          <img src="/assets/overview/industries/industry-hero-team.webp" alt="Distributed promotional products team reviewing one project together" />
        </div>
      </div>
    </section>

    <section class="overview-section industries-intro" id="industry-list">
      <div class="overview-shell">
        <header class="overview-heading">
          <p class="overview-kicker">Built for the promo workflow</p>
          <h2>Clearer handoffs for every role.</h2>
          <p>Each team sees the same approved version, product context, and production details without reconstructing the order from separate files and messages.</p>
        </header>
        <div class="industry-overview-grid">
          {industries.map((industry) => (
            <a class="industry-overview-card" href={industry.href}>
              <img src={industry.image} alt={industry.alt} loading="lazy" />
              <div class="industry-overview-copy">
                <span>{industry.number} / {industry.role}</span>
                <h2>{industry.title}</h2>
                <p>{industry.text}</p>
                <div class="industry-tags">
                  {industry.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <div class="industry-card-link">{industry.link} <b aria-hidden="true">-&gt;</b></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-section connected-story">
      <div class="overview-shell">
        <header class="overview-heading">
          <p class="overview-kicker">One connected system</p>
          <h2>Clear at every handoff.</h2>
          <p>The project gains context as it moves forward. Nobody has to reconstruct the decision from separate messages and files.</p>
        </header>
        <div class="connection-track">
          {connections.map(([title, text], index) => (
            <article class="connection-node">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-contact-banner" id="industry-contact" aria-labelledby="industry-contact-title">
      <div class="overview-shell">
        <div class="overview-contact-copy">
          <p class="overview-kicker">One connected workflow</p>
          <h2 id="industry-contact-title">Bring every team into one clear workflow.</h2>
          <p>See how PromoPlus fits your role and the partners you work with.</p>
        </div>
        <div class="overview-contact-actions">
          <a class="overview-contact-primary" href="/pricing#custom-plan-form">Book a Demo <span aria-hidden="true">-&gt;</span></a>
          <a class="overview-contact-secondary" href="/features">Explore Features <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer top="#main-content" />
</BaseLayout>

