---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/production-ready-files.css';
---
<BaseLayout title="Production-Ready File Generation | PromoPlus" description="Generate production-ready PDF files with approved artwork and placement details in PromoPlus." bodyClass="feature-page production-files-page">
<Header active="features" />
<Fragment set:html={"<main id=\"main-content\">\n  <section class=\"production-hero\">\n    <div class=\"production-hero-shade\" aria-hidden=\"true\"></div>\n    <div class=\"production-hero-copy\">\n      <p class=\"feature-kicker\">Production-Ready File Generation</p>\n      <h1>Approval becomes a <strong>confident handoff.</strong></h1>\n      <p class=\"feature-lede\">After customer approval, PromoPlus automatically generates production-ready PDF files with the approved artwork and placement details.</p>\n      <div class=\"feature-actions\">\n        <a class=\"feature-primary-action\" href=\"#production-file\">See the production file <span aria-hidden=\"true\">↓</span></a>\n        <a class=\"feature-secondary-action\" href=\"customer-approval-portal.html\">Start with approval <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </div>\n    <figure class=\"production-hero-image\">\n      <img src=\"../assets/features/production-files/production-hero.png\" alt=\"Production lead reviewing a garment proof beside a cobalt sweatshirt\">\n      <figcaption><span>Approved artwork</span><b>Ready for production</b><i>PDF</i></figcaption>\n    </figure>\n  </section>\n\n  <section class=\"production-proof feature-shell\" id=\"production-file\">\n    <header class=\"production-proof-copy\">\n      <p class=\"feature-kicker\">One approved record</p>\n      <h2>Everything production needs. <strong>Nothing left to guess.</strong></h2>\n      <p>Files are ready to send directly to decorators or production teams.</p>\n    </header>\n    <div class=\"production-proof-layout\">\n      <div class=\"production-sheet-wrap\">\n        <div class=\"production-sheet\">\n          <div class=\"sheet-header\">\n            <div><small>Production PDF</small><b>Custom Sweatshirt Campaign</b></div>\n            <span>Approved V3</span>\n          </div>\n          <div class=\"sheet-preview\">\n            <div class=\"sheet-garment\" aria-hidden=\"true\"><i></i></div>\n            <div class=\"sheet-measure horizontal\"></div>\n            <div class=\"sheet-measure vertical\"></div>\n            <b class=\"placement-label\">Front placement</b>\n          </div>\n          <div class=\"sheet-specs\">\n            <div><small>Artwork</small><b>logo-final.svg</b></div>\n            <div><small>Product</small><b>Custom Sweatshirt</b></div>\n            <div><small>Approved</small><b>Jun 16, 2026 · 5:37 PM</b></div>\n          </div>\n          <div class=\"sheet-footer\"><span>Production output</span><b>Locked</b></div>\n        </div>\n        <div class=\"production-sheet-back back-one\" aria-hidden=\"true\"></div>\n        <div class=\"production-sheet-back back-two\" aria-hidden=\"true\"></div>\n      </div>\n      <aside class=\"surface-control\" aria-label=\"Production file side details\">\n        <p>Placement details</p>\n        <div class=\"surface-tabs\" role=\"tablist\" aria-label=\"Product sides\">\n          <button type=\"button\" class=\"is-active\" role=\"tab\" aria-selected=\"true\" data-side=\"front\">Front</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-side=\"back\">Back</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-side=\"sleeve\">Sleeve</button>\n        </div>\n        <div class=\"surface-detail\" aria-live=\"polite\">\n          <span id=\"surface-index\">01</span>\n          <h3 id=\"surface-title\">Front artwork</h3>\n          <p id=\"surface-copy\">Centered 3.5 in below collar with approved scale and color reference.</p>\n        </div>\n      </aside>\n    </div>\n  </section>\n\n  <section class=\"production-handoff\">\n    <figure>\n      <img src=\"../assets/features/production-files/production-handoff.png\" alt=\"Production proof, cobalt sweatshirt, color chips, and handoff tools arranged on a worktable\">\n    </figure>\n    <div>\n      <p class=\"feature-kicker\">From approval to output</p>\n      <h2>A clean package for the people who make it real.</h2>\n      <p>The final proof keeps the approved artwork, product sides, placement guidance, and decision record together.</p>\n      <ul>\n        <li><span>01</span> Approved artwork only</li>\n        <li><span>02</span> Placement details included</li>\n        <li><span>03</span> Ready for decorators and production teams</li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"production-sequence feature-shell\">\n    <p class=\"feature-kicker\">How the handoff works</p>\n    <div class=\"production-sequence-grid\">\n      <article><span>Approve</span><h3>The client locks the final version.</h3><i>01</i></article>\n      <article><span>Generate</span><h3>PromoPlus assembles the production PDF.</h3><i>02</i></article>\n      <article><span>Produce</span><h3>Your team sends one trusted file forward.</h3><i>03</i></article>\n    </div>\n  </section>\n\n  <section class=\"production-benefits feature-shell\">\n    <div>\n      <p class=\"feature-kicker\">Benefits</p>\n      <h2>A faster path from <strong>yes</strong> to production.</h2>\n    </div>\n    <div class=\"production-benefit-grid\">\n      <article><span>01</span><h3>Faster production handoff.</h3><p>Move from approval to output without rebuilding the file.</p></article>\n      <article><span>02</span><h3>Fewer manual preparation steps.</h3><p>Keep approved details together and ready to share.</p></article>\n      <article><span>03</span><h3>Reduced production errors.</h3><p>Give the production team the exact approved version.</p></article>\n      <article><span>04</span><h3>Greater confidence before printing.</h3><p>Make every final handoff clear and verifiable.</p></article>\n    </div>\n  </section>\n\n  <section class=\"production-outcome feature-shell\">\n    <p class=\"feature-kicker\">Customer outcome</p>\n    <h2>Generate production-ready files <strong>with confidence.</strong></h2>\n    <p>Reduce production errors and customer disputes while keeping every final decision attached.</p>\n  </section>\n\n  <section class=\"feature-related feature-shell\">\n    <div class=\"feature-section-heading\"><div><p class=\"feature-kicker\">Connected workflow</p><h2>Start before the handoff.</h2></div><p>Production-ready files are stronger when every decision leading to them is already clear.</p></div>\n    <div class=\"feature-related-grid\">\n      <a class=\"production-related-link\" href=\"customer-approval-portal.html\"><small>Previous feature</small><h3>Customer Approval Portal</h3><p>Collect and record the decision that creates the final file.</p><span>Explore feature ↗</span></a>\n      <a class=\"production-related-link\" href=\"artwork-version-control.html\"><small>Connected feature</small><h3>Artwork Version Control</h3><p>Know exactly which version belongs in production.</p><span>Explore feature ↗</span></a>\n    </div>\n  </section>\n\n  <section class=\"feature-cta production-cta\" id=\"production-cta\">\n    <p class=\"feature-kicker\">Ready to produce?</p>\n    <h2>Send one approved file forward with confidence.</h2>\n    <div class=\"feature-actions\"><a class=\"feature-primary-action\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span aria-hidden=\"true\">↗</span></a><a class=\"feature-secondary-action\" href=\"../index.html#journey\">View the workflow <span aria-hidden=\"true\">↓</span></a></div>\n  </section>\n</main>"} />
<Footer variant="feature" label="Production-Ready File Generation" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/script.js"></script>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/production-ready-files.js"></script>
</BaseLayout>



