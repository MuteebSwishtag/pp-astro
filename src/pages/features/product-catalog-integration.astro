---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/product-catalog.css';
---
<BaseLayout title="Product Catalog Integration | PromoPlus" description="Search integrated supplier catalogs and start product projects instantly with PromoPlus Product Catalog Integration." bodyClass="feature-page catalog-page">
<Header active="features" />
<Fragment set:html={"<main>\n  <section class=\"catalog-hero feature-shell\" aria-labelledby=\"catalog-title\">\n    <div class=\"catalog-hero-copy\">\n      <p class=\"feature-kicker\">Product Catalog Integration</p>\n      <h1 id=\"catalog-title\" class=\"hero-title display-title\">Find the right product. <span>Start designing instantly.</span></h1>\n      <p class=\"feature-lede\">Distributors can instantly search integrated supplier catalogs using vendor names, SKUs, or keywords—without downloading product images or manually rebuilding product data.</p>\n      <div class=\"feature-actions\"><a class=\"button button-dark\" href=\"#catalog-search-story\">Explore the catalog <span>↓</span></a><a class=\"button button-light\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span>↗</span></a></div>\n    </div>\n    <div class=\"catalog-hero-visual\" data-catalog-scene>\n      <img src=\"../assets/features/catalog/catalog-hero-products.png\" alt=\"A coordinated supplier catalog collection with a cap, bottle, tote, mug, and notebook\">\n      <form class=\"catalog-search-bar\" role=\"search\" onsubmit=\"return false\">\n        <span aria-hidden=\"true\"></span>\n        <label class=\"sr-only\" for=\"catalog-query\">Search products</label>\n        <input id=\"catalog-query\" type=\"text\" value=\"Insulated bottle\" aria-label=\"Search by vendor, SKU, or keyword\">\n        <kbd>⌘ K</kbd>\n      </form>\n      <div class=\"catalog-category-tabs\" aria-label=\"Product categories\">\n        <button type=\"button\" data-product=\"drinkware\" class=\"is-active\">Drinkware</button>\n        <button type=\"button\" data-product=\"apparel\">Apparel</button>\n        <button type=\"button\" data-product=\"bags\">Bags</button>\n      </div>\n      <article class=\"catalog-result-preview\" aria-live=\"polite\">\n        <small>Selected product</small>\n        <strong>Vacuum Bottle 24 oz.</strong>\n        <span>SKU VB-240 · 12 colors</span>\n        <i>Ready to design</i>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"catalog-utility-strip\" aria-label=\"Catalog search capabilities\">\n    <div><span>Search by</span><strong>Vendor</strong></div>\n    <div><span>Search by</span><strong>SKU</strong></div>\n    <div><span>Search by</span><strong>Keyword</strong></div>\n    <div><span>Keep</span><strong>Product data</strong></div>\n    <div><span>Move to</span><strong>Design</strong></div>\n  </section>\n\n  <section class=\"catalog-friction feature-shell\">\n    <div class=\"catalog-friction-heading\">\n      <p class=\"feature-kicker\">Remove the setup work</p>\n      <h2>Product setup should not begin with downloading images.</h2>\n      <p>No more searching supplier websites, saving product photography, or manually uploading products into design software. Everything starts inside PromoPlus.</p>\n    </div>\n    <div class=\"catalog-old-new\">\n      <div class=\"old-way-list\" aria-label=\"Old product setup workflow\">\n        <article><span>01</span><p>Search a supplier website</p><i>Open another tab</i></article>\n        <article><span>02</span><p>Download product images</p><i>Save and rename</i></article>\n        <article><span>03</span><p>Rebuild the product record</p><i>Copy the details</i></article>\n      </div>\n      <article class=\"catalog-one-step\">\n        <small>Inside PromoPlus</small>\n        <strong>Search. Select. Start.</strong>\n        <p>The product arrives with the information the team needs to begin the project.</p>\n        <span>One connected start <i>↗</i></span>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"catalog-search-story\" id=\"catalog-search-story\">\n    <div class=\"feature-shell catalog-story-layout\">\n      <figure class=\"catalog-buyer-photo\">\n        <img src=\"../assets/features/catalog/catalog-search-buyer.png\" alt=\"A promotional products buyer comparing catalog results with physical product samples\">\n        <figcaption><span>Search where the work begins</span><strong>Compare products and move the right one into the project.</strong></figcaption>\n      </figure>\n      <div class=\"catalog-story-copy\">\n        <p class=\"feature-kicker\">How it works</p>\n        <h2>From supplier catalog to active project.</h2>\n        <p>Product discovery becomes the first connected step in the PromoPlus workflow.</p>\n        <ol class=\"catalog-story-steps\">\n          <li class=\"is-active\"><span>01</span><div><strong>Search the catalog</strong><p>Use a vendor name, SKU, or product keyword.</p></div></li>\n          <li><span>02</span><div><strong>Select the product</strong><p>Keep standardized product information and imagery together.</p></div></li>\n          <li><span>03</span><div><strong>Start designing</strong><p>Move directly into the mockup workflow without rebuilding the product.</p></div></li>\n        </ol>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"catalog-standard feature-shell\">\n    <div class=\"catalog-standard-copy\">\n      <p class=\"feature-kicker\">Standardized product information</p>\n      <h2>Every product starts with a cleaner record.</h2>\n      <p>Consistent supplier details give sales, design, and production the same point of reference from the beginning.</p>\n    </div>\n    <figure class=\"catalog-standard-photo\">\n      <img src=\"../assets/features/catalog/catalog-standardized-products.png\" alt=\"Promotional products displayed in a consistent modular catalog system\">\n      <figcaption><span>One catalog language</span><strong>Different categories. Consistent information.</strong></figcaption>\n    </figure>\n    <div class=\"catalog-data-row\" aria-label=\"Standard product information\">\n      <span>Supplier</span><span>SKU</span><span>Category</span><span>Color options</span><span>Product imagery</span>\n    </div>\n  </section>\n\n  <section class=\"catalog-benefits\">\n    <div class=\"feature-shell\">\n      <div class=\"catalog-benefits-heading\">\n        <p class=\"feature-kicker\">Benefits</p>\n        <h2>Less searching. More time moving the project forward.</h2>\n      </div>\n      <div class=\"catalog-benefit-list\">\n        <article><span>01</span><h3>Save time finding products.</h3><p>Search the supplier catalog from the same place the project will be created.</p></article>\n        <article><span>02</span><h3>Eliminate repetitive manual work.</h3><p>Stop downloading and rebuilding the same product information for every proof.</p></article>\n        <article><span>03</span><h3>Standardize product information.</h3><p>Give every team a more consistent product record from the first step.</p></article>\n        <article><span>04</span><h3>Start designing instantly.</h3><p>Move the selected product directly into the online mockup workflow.</p></article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"catalog-outcome feature-shell\">\n    <div>\n      <p class=\"feature-kicker\">Customer outcome</p>\n      <h2>Everything starts inside PromoPlus.</h2>\n    </div>\n    <div class=\"catalog-outcome-path\" aria-label=\"Connected catalog outcome\">\n      <span>Supplier catalog</span><i>→</i><span>Selected product</span><i>→</i><strong>Ready to design</strong>\n    </div>\n  </section>\n\n  <section class=\"related-features feature-shell\">\n    <div class=\"feature-section-heading\"><p class=\"feature-kicker\">Connected workflow</p><h2>The selected product is ready for what comes next.</h2></div>\n    <div class=\"related-grid\">\n      <a href=\"online-mockup-designer.html\"><small>Continue with</small><h3>Online Mockup Designer</h3><p>Place artwork and generate a customer-ready mockup.</p><span>Explore feature ↗</span></a>\n      <a class=\"catalog-related-link\" href=\"centralized-project-workspace.html\"><small>Keep it together in</small><h3>Centralized Project Workspace</h3><p>Connect products, artwork, customer information, and project history.</p><span>Explore feature ↗</span></a>\n      <article><small>See progress through</small><h3>Workflow Progress Dashboard</h3><p>Know where every product project is moving or blocked.</p><span>Planned</span></article>\n    </div>\n  </section>\n\n  <section class=\"feature-cta feature-shell\" id=\"catalog-contact\">\n    <div><p class=\"feature-kicker\">Bring your supplier catalog</p><h2>Ready to find products without the manual setup?</h2></div>\n    <a class=\"press-button\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <i>↗</i></a>\n  </section>\n</main>"} />
<Footer variant="feature" label="Product Catalog Integration" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/product-catalog.js"></script>
</BaseLayout>



