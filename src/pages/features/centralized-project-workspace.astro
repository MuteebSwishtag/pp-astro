---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/centralized-workspace.css';
---
<BaseLayout title="Centralized Project Workspace | PromoPlus" description="Keep products, artwork, customer information, approvals, notes, production files, and project history together in PromoPlus." bodyClass="feature-page workspace-page">
<Header active="features" />
<Fragment set:html={"<main>\n  <section class=\"workspace-hero feature-shell\" aria-labelledby=\"workspace-title\">\n    <div class=\"workspace-hero-copy\">\n      <p class=\"feature-kicker\">Centralized Project Workspace</p>\n      <h1 id=\"workspace-title\" class=\"hero-title display-title\">One project. <span>Every detail stays connected.</span></h1>\n      <p class=\"feature-lede\">Every project lives in one place. Store products, artwork, customer information, approvals, notes, production files, and project history together.</p>\n      <div class=\"feature-actions\"><a class=\"button button-dark\" href=\"#record-explorer\">Explore the workspace <span>↓</span></a><a class=\"button button-light\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span>↗</span></a></div>\n    </div>\n    <figure class=\"workspace-hero-photo\">\n      <img src=\"../assets/features/workspace/workspace-hero-team.png\" alt=\"A promotional products team coordinating one connected project around a shared table\">\n      <div class=\"workspace-photo-index\" aria-hidden=\"true\">\n        <span style=\"--x:8%;--y:12%\">Product</span>\n        <span style=\"--x:35%;--y:80%\">Artwork</span>\n        <span style=\"--x:66%;--y:9%\">Customer</span>\n        <span style=\"--x:78%;--y:73%\">Approval</span>\n      </div>\n      <figcaption><span>Custom Merchandise Campaign</span><strong>Everything the team needs, in one project record.</strong></figcaption>\n    </figure>\n  </section>\n\n  <section class=\"workspace-record-strip\" aria-label=\"Information stored in one project\">\n    <span>Products</span><i>+</i><span>Artwork</span><i>+</i><span>Customer information</span><i>+</i><span>Approvals</span><i>+</i><span>Notes</span><i>+</i><span>Production files</span><i>+</i><span>Project history</span>\n  </section>\n\n  <section class=\"workspace-problem feature-shell\">\n    <p class=\"feature-kicker\">Stop searching for context</p>\n    <div class=\"workspace-problem-grid\">\n      <h2>The project should not disappear across inboxes and shared folders.</h2>\n      <div><p>No more searching through emails or shared folders. PromoPlus keeps the project record intact from the first product choice to the final production file.</p><strong>One place to understand what happened—and what happens next.</strong></div>\n    </div>\n    <div class=\"scatter-to-record\">\n      <div class=\"scatter-items\" aria-label=\"Disconnected project information\">\n        <span>Email comment</span><span>Product link</span><span>Artwork final</span><span>Customer note</span><span>Approval PDF</span>\n      </div>\n      <i aria-hidden=\"true\">→</i>\n      <article><small>Connected project</small><b>Custom Hoodie Campaign</b><span>Complete record · current status</span></article>\n    </div>\n  </section>\n\n  <section class=\"record-explorer\" id=\"record-explorer\">\n    <div class=\"feature-shell\">\n      <div class=\"record-explorer-heading\">\n        <p class=\"feature-kicker\">Inside one project</p>\n        <h2>Seven layers. One source of truth.</h2>\n        <p>Select a project layer to see how it stays connected to the same record.</p>\n      </div>\n      <div class=\"record-explorer-grid\">\n        <div class=\"record-tabs\" role=\"tablist\" aria-label=\"Project record layers\">\n          <button class=\"is-active\" type=\"button\" role=\"tab\" aria-selected=\"true\" data-record=\"products\"><span>01</span>Products</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-record=\"artwork\"><span>02</span>Artwork</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-record=\"customer\"><span>03</span>Customer information</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-record=\"approvals\"><span>04</span>Approvals</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-record=\"notes\"><span>05</span>Notes</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-record=\"production\"><span>06</span>Production files</button>\n          <button type=\"button\" role=\"tab\" aria-selected=\"false\" data-record=\"history\"><span>07</span>Project history</button>\n        </div>\n        <div class=\"record-object\" aria-hidden=\"true\">\n          <span class=\"record-sheet sheet-a\"></span><span class=\"record-sheet sheet-b\"></span>\n          <article><small>Connected record</small><b>Custom Hoodie Campaign</b><div><span>Current layer</span><strong>Products</strong></div><i>Live</i></article>\n        </div>\n        <div class=\"record-detail\" role=\"tabpanel\" aria-live=\"polite\">\n          <small>Products</small>\n          <h3>The selected product stays attached to the project.</h3>\n          <p>Supplier details, product imagery, sides, and color choices remain available to everyone working on the campaign.</p>\n          <div><span>Connected to</span><strong>Artwork · Mockups · Production</strong></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"project-history feature-shell\">\n    <div class=\"project-history-copy\">\n      <p class=\"feature-kicker\">Complete project history</p>\n      <h2>See the whole story, not just the latest file.</h2>\n      <p>Products, source artwork, comments, decisions, and production output remain part of the same chronological record.</p>\n    </div>\n    <figure class=\"project-history-photo\">\n      <img src=\"../assets/features/workspace/workspace-project-history.png\" alt=\"An organized project archive showing product information, artwork versions, notes, approval, and production output\">\n      <figcaption><span>Project archive</span><strong>Every handoff leaves useful context behind.</strong></figcaption>\n    </figure>\n    <ol class=\"history-line\" aria-label=\"Project history sequence\">\n      <li><span>Product added</span><small>09:12</small></li>\n      <li><span>Artwork uploaded</span><small>10:04</small></li>\n      <li><span>Version reviewed</span><small>14:18</small></li>\n      <li><span>Customer approved</span><small>17:37</small></li>\n      <li><span>Production file</span><small>17:39</small></li>\n    </ol>\n  </section>\n\n  <section class=\"workspace-collaboration\">\n    <figure>\n      <img src=\"../assets/features/workspace/workspace-team-handoff.png\" alt=\"Client service and production professionals reviewing the same promotional product project\">\n    </figure>\n    <div class=\"workspace-collaboration-copy\">\n      <p class=\"feature-kicker\">Better collaboration</p>\n      <h2>Every team works from the same information.</h2>\n      <p>Sales, design, operations, and production can understand the current project without asking someone else to reconstruct the story.</p>\n      <div><span>Sales</span><i>→</i><span>Design</span><i>→</i><span>Production</span></div>\n    </div>\n  </section>\n\n  <section class=\"workspace-benefits\">\n    <div class=\"feature-shell\">\n      <div class=\"workspace-benefits-heading\"><p class=\"feature-kicker\">Benefits</p><h2>Clarity that stays with the work.</h2></div>\n      <div class=\"workspace-benefit-columns\">\n        <article><span>01</span><h3>One source of truth.</h3><p>Keep the project’s products, files, people, and decisions together.</p></article>\n        <article><span>02</span><h3>Complete project history.</h3><p>Understand how the project changed and which decisions moved it forward.</p></article>\n        <article><span>03</span><h3>Better collaboration.</h3><p>Give every team the same context without another internal handoff.</p></article>\n        <article><span>04</span><h3>Greater operational visibility.</h3><p>See the current state of work and the information behind it.</p></article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"workspace-outcome feature-shell\">\n    <div><p class=\"feature-kicker\">Customer outcome</p><h2>Keep every artwork project organized in one place.</h2></div>\n    <blockquote>“The project record becomes the place the team trusts—not another folder they have to search.”</blockquote>\n  </section>\n\n  <section class=\"related-features feature-shell\">\n    <div class=\"feature-section-heading\"><p class=\"feature-kicker\">Connected workflow</p><h2>The workspace connects every specialist feature.</h2></div>\n    <div class=\"related-grid\">\n      <a class=\"workspace-related-link\" href=\"product-catalog-integration.html\"><small>Products enter through</small><h3>Product Catalog Integration</h3><p>Find the right supplier product and add it to the project.</p><span>Explore feature ↗</span></a>\n      <a class=\"workspace-related-link\" href=\"online-mockup-designer.html\"><small>Artwork becomes a proof in</small><h3>Online Mockup Designer</h3><p>Place artwork and create a customer-ready mockup.</p><span>Explore feature ↗</span></a>\n      <article><small>Progress becomes visible in</small><h3>Workflow Progress Dashboard</h3><p>Track every connected project from creation to production.</p><span>Planned</span></article>\n    </div>\n  </section>\n\n  <section class=\"feature-cta feature-shell\" id=\"workspace-contact\">\n    <div><p class=\"feature-kicker\">Bring the project together</p><h2>Ready to replace scattered files with one connected workspace?</h2></div>\n    <a class=\"press-button\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <i>↗</i></a>\n  </section>\n</main>"} />
<Footer variant="feature" label="Centralized Project Workspace" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/centralized-workspace.js"></script>
</BaseLayout>



