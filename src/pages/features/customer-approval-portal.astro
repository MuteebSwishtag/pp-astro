---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/customer-approval-portal.css';
---
<BaseLayout title="Customer Approval Portal | PromoPlus" description="Share mockups, collect feedback, and record approvals through the PromoPlus Customer Approval Portal." bodyClass="feature-page approval-page">
<Header active="features" />
<Fragment set:html={"<main id=\"main-content\">\n  <section class=\"approval-hero\">\n    <div class=\"approval-hero-copy\">\n      <p class=\"feature-kicker\">Customer Approval Portal</p>\n      <h1>One link. One clear <strong>decision.</strong></h1>\n      <p class=\"feature-lede\">Share artwork through a secure online approval link. Customers can review mockups, approve designs, request revisions, and leave comments without endless email chains.</p>\n      <div class=\"feature-actions\"><a class=\"feature-primary\" href=\"#approval-demo\">Explore the portal ↓</a><a class=\"feature-secondary\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan ↗</a></div>\n    </div>\n    <figure class=\"approval-hero-image\">\n      <img src=\"../assets/features/approval-portal/approval-portal-hero.png\" alt=\"Business owner reviewing a promotional tote mockup on a tablet\">\n      <span class=\"approval-pin pin-one\">1</span><span class=\"approval-pin pin-two\">2</span>\n      <figcaption><span>Secure review link</span><strong>Ready for feedback</strong></figcaption>\n    </figure>\n  </section>\n\n  <section class=\"approval-strip\"><span>Review mockup</span><i>+</i><span>Leave comments</span><i>+</i><span>Request revisions</span><i>+</i><span>Approve design</span></section>\n\n  <section class=\"approval-problem feature-shell\">\n    <p class=\"feature-kicker\">Feedback without the chase</p>\n    <h2>Stop turning client decisions into email archaeology.</h2>\n    <div class=\"approval-problem-grid\">\n      <article><span>12:08</span><p>“Can you make the logo a little larger?”</p><small>Email reply</small></article>\n      <article><span>12:21</span><p>“Which mockup are we reviewing?”</p><small>Forwarded thread</small></article>\n      <article><span>13:04</span><p>“Approved!”</p><small>Missing version context</small></article>\n      <div><b>PromoPlus keeps every comment and decision attached to the exact mockup.</b></div>\n    </div>\n  </section>\n\n  <section class=\"approval-demo\" id=\"approval-demo\">\n    <div class=\"approval-demo-copy\">\n      <p class=\"feature-kicker\">Interactive approval review</p>\n      <h2>Everything the client needs. Nothing they don’t.</h2>\n      <p>Select a feedback pin, review the note, then move the mockup from In Review to Approved.</p>\n      <div class=\"approval-state\"><span id=\"approval-state-dot\"></span><b id=\"approval-state-label\">In Review</b><small id=\"approval-state-detail\">2 comments open</small></div>\n    </div>\n    <div class=\"approval-screen\">\n      <div class=\"approval-screen-top\"><span>Custom Tote Campaign / V3</span><b id=\"approval-screen-status\">In Review</b></div>\n      <div class=\"approval-product\">\n        <div class=\"approval-tote\"><span></span></div>\n        <button class=\"review-pin review-pin-one is-active\" type=\"button\" data-comment=\"0\" aria-label=\"Open comment one\">1</button>\n        <button class=\"review-pin review-pin-two\" type=\"button\" data-comment=\"1\" aria-label=\"Open comment two\">2</button>\n      </div>\n      <aside class=\"approval-comment\" aria-live=\"polite\">\n        <small id=\"comment-author\">Sarah / Client</small>\n        <p id=\"comment-copy\">Can we move the artwork slightly higher?</p>\n        <span id=\"comment-meta\">Front · Placement</span>\n      </aside>\n      <div class=\"approval-actions\">\n        <button type=\"button\" id=\"request-change\">Request revision</button>\n        <button type=\"button\" id=\"approve-design\">Approve design <span>✓</span></button>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"approval-feedback feature-shell\">\n    <figure><img src=\"../assets/features/approval-portal/approval-feedback.png\" alt=\"Two clients reviewing an embroidered cap proof together\"></figure>\n    <div>\n      <p class=\"feature-kicker\">Clear communication</p>\n      <h2>Feedback stays beside the product it describes.</h2>\n      <p>Clients review the visual, respond to the exact placement, and make the next step clear without searching for context.</p>\n      <ul><li>Comment on the mockup</li><li>Request a revision</li><li>Approve the final design</li></ul>\n    </div>\n  </section>\n\n  <section class=\"approval-record\">\n    <div class=\"feature-shell\">\n      <p class=\"feature-kicker\">Every approval is recorded</p>\n      <h2>A decision your team can verify.</h2>\n      <div class=\"record-line\"><span>Customer</span><b>Approved V3</b><time>Jun 16, 2026 · 5:37 PM</time><i>Recorded</i></div>\n    </div>\n  </section>\n\n  <section class=\"approval-benefits feature-shell\">\n    <div><p class=\"feature-kicker\">Benefits</p><h2>Faster answers. Better client experience.</h2></div>\n    <div class=\"approval-benefit-grid\">\n      <article><span>01</span><h3>Faster approvals.</h3><p>Give clients one direct place to review and decide.</p></article>\n      <article><span>02</span><h3>Clear communication.</h3><p>Keep feedback connected to the exact mockup.</p></article>\n      <article><span>03</span><h3>Reduced disputes.</h3><p>Preserve an explicit record of the final decision.</p></article>\n      <article><span>04</span><h3>Better customer experience.</h3><p>Replace long email threads with a focused review.</p></article>\n    </div>\n  </section>\n\n  <section class=\"approval-outcome feature-shell\"><p class=\"feature-kicker\">Customer outcome</p><h2>Accelerate customer approvals.</h2><p>One secure review destination keeps the project moving toward production.</p></section>\n\n  <section class=\"related-features feature-shell\">\n    <p class=\"feature-kicker\">Connected features</p>\n    <div class=\"related-grid\">\n      <a class=\"approval-related-link\" href=\"artwork-version-control.html\"><small>Review the right revision with</small><h3>Artwork Version Control</h3><p>Keep each revision clear before it reaches the client.</p><span>Explore feature ↗</span></a>\n      <a class=\"approval-related-link\" href=\"centralized-project-workspace.html\"><small>Keep the decision in</small><h3>Centralized Project Workspace</h3><p>Store the client, mockup, comments, and approval together.</p><span>Explore feature ↗</span></a>\n    </div>\n  </section>\n\n  <section class=\"feature-final-cta\" id=\"approval-cta\"><div><p class=\"feature-kicker\">One link. One decision.</p><h2>Ready to make client approvals easier?</h2></div><a class=\"feature-primary\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan ↗</a></section>\n</main>"} />
<Footer variant="feature" label="Customer Approval Portal" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/customer-approval-portal.js"></script>
</BaseLayout>



