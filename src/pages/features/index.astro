---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/overview-pages.css';

const features = [
  {
    number: '01',
    heroTitle: 'Product Catalog',
    heroText: 'Find the right supplier product',
    cardTitle: 'Choose Product',
    text: 'Search the supplier catalog, compare products, and begin every project with the correct item details.',
    href: '/features/product-catalog-integration',
    image: '/assets/overview/features/product-catalog.webp',
    alt: 'Coordinated promotional product catalog',
  },
  {
    number: '02',
    heroTitle: 'Mockup Designer',
    heroText: 'Build customer-ready visuals',
    cardTitle: 'Create Mockup',
    text: 'Place client artwork on the product, set the color and position, and build a proof the client can understand.',
    href: '/features/online-mockup-designer',
    image: '/assets/overview/features/online-mockup-designer.webp',
    alt: 'Promotional apparel mockup',
  },
  {
    number: '03',
    heroTitle: 'Version Control',
    heroText: 'Keep every revision clear',
    cardTitle: 'Revise Artwork',
    text: 'Save every change as a new version and keep earlier artwork available without confusing the current file.',
    href: '/features/artwork-version-control',
    image: '/assets/overview/features/artwork-version-control.webp',
    alt: 'Artwork versions prepared for comparison',
  },
  {
    number: '04',
    heroTitle: 'Approval Portal',
    heroText: 'Capture one clear decision',
    cardTitle: 'Approve Design',
    text: 'Share one secure link where the client can comment, request a revision, or approve the latest design.',
    href: '/features/customer-approval-portal',
    image: '/assets/overview/features/customer-approval-portal.webp',
    alt: 'Customer approval portal',
  },
  {
    number: '05',
    heroTitle: 'Project Workspace',
    heroText: 'Keep every detail together',
    cardTitle: 'Organize Project',
    text: 'Keep product selections, artwork, mockups, notes, decisions, and production output in one workspace.',
    href: '/features/centralized-project-workspace',
    image: '/assets/overview/features/centralized-workspace.webp',
    alt: 'Team using a centralized project workspace',
  },
  {
    number: '06',
    heroTitle: 'Team Collaboration',
    heroText: 'Align every role in context',
    cardTitle: 'Collaborate',
    text: 'Give sales, art, clients, and production the project context they need without scattered email threads.',
    href: '/features/team-collaboration',
    image: '/assets/overview/features/team-collaboration.webp',
    alt: 'Promo team collaborating around a project',
  },
  {
    number: '07',
    heroTitle: 'Workflow Dashboard',
    heroText: 'See what is moving or waiting',
    cardTitle: 'Monitor Progress',
    text: 'See every active project, what is waiting, where approval is blocked, and what is ready to move forward.',
    href: '/features/workflow-progress-dashboard',
    image: '/assets/overview/features/workflow-dashboard.webp',
    alt: 'PromoPlus workflow progress dashboard',
  },
  {
    number: '08',
    heroTitle: 'Production Files',
    heroText: 'Send the approved handoff',
    cardTitle: 'Produce Files',
    text: 'Turn the approved mockup and final artwork into a clean production-ready handoff with confirmed details.',
    href: '/features/production-ready-file-generation',
    image: '/assets/overview/features/production-files.webp',
    alt: 'Production-ready promotional product proof',
  },
];
---

<BaseLayout
  title="Features | PromoPlus"
  description="Explore PromoPlus features for product selection, mockups, artwork revisions, client approvals, collaboration, workflow tracking, and production-ready files."
  bodyClass="overview-page feature-overview-page"
>
  <Header active="features" />
  <main id="main-content">
    <section class="overview-hero feature-home">
      <div class="overview-hero-copy">
        <p class="overview-kicker">PromoPlus Features</p>
        <h1>Features that keep<strong>every handoff connected.</strong></h1>
        <p>Choose products, build mockups, collect a clear client decision, and send the approved files to production without losing context between tools.</p>
        <div class="overview-actions">
          <a class="overview-primary" href="#all-features">Explore All Features <span aria-hidden="true">-&gt;</span></a>
          <a class="overview-secondary" href="/pricing#custom-plan-form">Book a Demo <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
      <div class="overview-hero-visual feature-list-visual" aria-label="PromoPlus feature list">
        <div class="feature-hero-list">
          <div class="feature-hero-list-head"><span>PromoPlus feature set</span><b>Connected</b></div>
          <ol>
            {features.map((feature) => (
              <li>
                <a href={feature.href}>
                  <span>{feature.number}</span>
                  <div>
                    <strong>{feature.heroTitle}</strong>
                    <small>{feature.heroText}</small>
                  </div>
                  <b>{feature.number}</b>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="overview-section all-features" id="all-features">
      <div class="overview-shell">
        <header class="feature-grid-heading">
          <p class="overview-kicker">Explore the platform</p>
          <h2>Features</h2>
          <p>Eight connected tools carry each project from product selection to a production-ready handoff.</p>
        </header>
        <div class="feature-cards feature-grid">
          {features.map((feature) => (
            <a class="feature-overview-card" href={feature.href}>
              <img src={feature.image} alt={feature.alt} loading="lazy" />
              <div class="feature-card-copy">
                <span>{feature.number}</span>
                <div><h3>{feature.cardTitle}</h3></div>
                <b aria-hidden="true">-&gt;</b>
                <p>{feature.text}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-contact-banner" aria-labelledby="feature-contact-title">
      <div class="overview-shell">
        <div class="overview-contact-copy">
          <p class="overview-kicker">See it in your workflow</p>
          <h2 id="feature-contact-title">Ready to make approvals easier?</h2>
          <p>Walk through all eight connected features with a PromoPlus product specialist.</p>
        </div>
        <div class="overview-contact-actions">
          <a class="overview-contact-primary" href="/pricing#custom-plan-form">Book a Demo <span aria-hidden="true">-&gt;</span></a>
          <a class="overview-contact-secondary" href="/pricing">View Pricing <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer top="#main-content" />
</BaseLayout>

