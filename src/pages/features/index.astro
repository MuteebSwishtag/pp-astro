---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/insights.css';
---
<BaseLayout title="Insights | PromoPlus" description="Live PromoPlus workflow insights for catalog activity, mockup creation, approvals, artwork versions, and production handoff." bodyClass="feature-page insights-page">
<Header active="features" />
<Fragment set:html={"<main id=\"main-content\">\n  <section class=\"insights-hero feature-shell\" aria-labelledby=\"insights-title\">\n    <div class=\"insights-hero-copy\">\n      <p class=\"feature-kicker\">Live PromoPlus Insights</p>\n      <h1 id=\"insights-title\">A real-time view of the work behind every approval.</h1>\n      <p class=\"feature-lede\">PromoPlus connects product selection, artwork placement, customer feedback, version history, approval records, and production-ready files into one live operating picture.</p>\n      <div class=\"live-meta\" aria-label=\"Live workspace status\">\n        <span><i></i> Workspace live</span>\n        <span>Updated <time id=\"liveTimestamp\" datetime=\"\">just now</time></span>\n      </div>\n      <div class=\"insights-metrics\" aria-label=\"Live PromoPlus metrics\">\n        <article><span>Active projects</span><strong data-live-number=\"86\">86</strong><small>Across catalog, proofing, approval, and production</small></article>\n        <article><span>Client decisions</span><strong data-live-number=\"74\">74</strong><small>Approvals and revision requests captured this month</small></article>\n        <article><span>Production handoffs</span><strong data-live-number=\"128\">128</strong><small>Approved PDFs generated from locked versions</small></article>\n      </div>\n    </div>\n    <figure class=\"insights-hero-panel\">\n      <img src=\"../assets/features/workflow-dashboard/dashboard-visibility.png\" alt=\"PromoPlus workflow dashboard showing project visibility across stages\">\n      <figcaption><b>Workflow pulse</b><span id=\"heroPulse\">12 projects need attention</span></figcaption>\n    </figure>\n  </section>\n\n  <section class=\"live-command feature-shell\" aria-labelledby=\"live-command-title\">\n    <header class=\"insights-section-heading\">\n      <p class=\"feature-kicker\">Operations command center</p>\n      <h2 id=\"live-command-title\">The signals PromoPlus keeps current while work is moving.</h2>\n      <p>These panels use the same workflow records described across the PromoPlus pages: catalog items, project history, team handoffs, mockups, versions, approvals, production PDFs, and dashboard blockers.</p>\n    </header>\n    <div class=\"command-layout\">\n      <section class=\"pipeline-panel\" aria-label=\"Live workflow pipeline\">\n        <div class=\"panel-top\"><span>Pipeline health</span><b id=\"pipelineHealth\">76% clear</b></div>\n        <div class=\"pipeline-list\">\n          <article style=\"--value:72%\"><span>Catalog started</span><b>62</b><i></i></article>\n          <article style=\"--value:58%\"><span>Mockups in review</span><b>41</b><i></i></article>\n          <article style=\"--value:46%\"><span>Awaiting client decision</span><b>26</b><i></i></article>\n          <article style=\"--value:34%\"><span>Production ready</span><b>19</b><i></i></article>\n        </div>\n      </section>\n      <section class=\"activity-panel\" aria-label=\"Live PromoPlus activity\">\n        <div class=\"panel-top\"><span>Live activity</span><b id=\"activityStage\">Approval</b></div>\n        <ul id=\"liveActivity\">\n          <li><span>Approval</span><strong>Retail opening staff hoodie approved for production.</strong><small>Now</small></li>\n          <li><span>Artwork</span><strong>Version 3 locked for the conference travel mug.</strong><small>2m ago</small></li>\n          <li><span>Catalog</span><strong>Drinkware shortlist added to Northline event project.</strong><small>5m ago</small></li>\n        </ul>\n      </section>\n      <section class=\"decision-panel\" aria-label=\"Recommended action\">\n        <div class=\"panel-top\"><span>Recommended focus</span><b>Today</b></div>\n        <h3>Clear the approval queue before production files are generated.</h3>\n        <p>Customer approval links and version locks are the highest-impact records because they decide which mockup becomes the production PDF.</p>\n        <a href=\"customer-approval-portal.html\">Review approval flow <span>&nearr;</span></a>\n      </section>\n    </div>\n  </section>\n\n  <section class=\"insights-stories feature-shell\" aria-labelledby=\"insights-stories-title\">\n    <header class=\"insights-section-heading\">\n      <p class=\"feature-kicker\">Realtime insight articles</p>\n      <h2 id=\"insights-stories-title\">Fresh reads from the PromoPlus workflow.</h2>\n      <p>Each article is built from the product, artwork, approval, and production signals already represented in this PromoPlus site.</p>\n    </header>\n    <div class=\"story-grid\" id=\"storyGrid\">\n      <a class=\"story-card\" href=\"../post.html?slug=from-artwork-to-production-a-better-promotional-product-proofing-workflow\">\n        <figure><img src=\"../assets/features/production-files/production-handoff.png\" alt=\"PromoPlus production handoff workflow for approved promotional product artwork\"></figure>\n        <div>\n          <small>PromoPlus insight</small>\n          <h3>From Artwork to Production: A Better Promotional Product Proofing Workflow</h3>\n          <p>Discover a streamlined workflow for managing promotional product artwork, mockups, client feedback, approvals, and production-ready files.</p>\n          <span>Aug 21, 2026 &middot; 2 min read</span>\n          <b class=\"story-cta\">Read insight <i>&nearr;</i></b>\n        </div>\n      </a>\n      <a class=\"story-card\" href=\"../post.html?slug=how-promotional-product-mockup-software-speeds-up-client-approvals\">\n        <figure><img src=\"../assets/features/approval-portal/approval-feedback.png\" alt=\"PromoPlus approval feedback attached to a product mockup\"></figure>\n        <div>\n          <small>PromoPlus insight</small>\n          <h3>How Promotional Product Mockup Software Speeds Up Client Approvals</h3>\n          <p>Learn how promotional product mockup software helps distributors create proofs faster, collect feedback, reduce revisions, and move approved artwork into production.</p>\n          <span>Aug 21, 2026 &middot; 2 min read</span>\n          <b class=\"story-cta\">Read insight <i>&nearr;</i></b>\n        </div>\n      </a>\n    </div>\n  </section>\n\n  <section class=\"signal-map feature-shell\" aria-labelledby=\"signal-map-title\">\n    <div class=\"signal-copy\">\n      <p class=\"feature-kicker\">Connected data map</p>\n      <h2 id=\"signal-map-title\">Every insight starts as a project record.</h2>\n      <p>The page updates its visible time, activity feed, and status labels in the browser. In a connected PromoPlus workspace, these same UI slots would be backed by live project events.</p>\n    </div>\n    <div class=\"signal-stack\" aria-label=\"PromoPlus record types\">\n      <span><b>Product</b><i>Catalog item selected</i></span>\n      <span><b>Artwork</b><i>Source file attached</i></span>\n      <span><b>Mockup</b><i>Front placement ready</i></span>\n      <span><b>Version</b><i>V3 locked</i></span>\n      <span><b>Approval</b><i>Client accepted</i></span>\n      <span><b>Production</b><i>PDF generated</i></span>\n    </div>\n  </section>\n\n  <section class=\"feature-cta feature-shell\" id=\"insights-contact\">\n    <div><p class=\"feature-kicker\">Use your own live records</p><h2>Turn every product approval into a workflow insight your team can act on.</h2></div>\n    <a class=\"press-button\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <i>&nearr;</i></a>\n  </section>\n</main>"} />
<Footer variant="feature" label="Insights" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/blog-data.js"></script>
<script is:inline src="/features/insights.js"></script>
</BaseLayout>



