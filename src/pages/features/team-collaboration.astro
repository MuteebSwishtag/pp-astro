---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/team-collaboration.css';
---
<BaseLayout title="Team Collaboration | PromoPlus" description="Bring sales, design, operations, and business owners together with PromoPlus Team Collaboration." bodyClass="feature-page collaboration-page">
<Header active="features" />
<Fragment set:html={"<main id=\"main-content\">\n  <section class=\"collaboration-hero\">\n    <figure><img src=\"../assets/features/team-collaboration/collaboration-hero.png\" alt=\"Sales, design, operations, and leadership reviewing a promotional bottle project together\"></figure>\n    <div class=\"collaboration-hero-copy\"><p class=\"feature-kicker\">Team Collaboration</p><h1>One shared project. <strong>Every role stays in context.</strong></h1><p class=\"feature-lede\">Sales representatives, brand advisors, designers, operations teams, and business owners collaborate inside one connected workspace.</p><div class=\"feature-actions\"><a class=\"feature-primary-action\" href=\"#shared-project\">Meet the workflow <span>&darr;</span></a><a class=\"feature-secondary-action\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span>&nearr;</span></a></div></div>\n    <div class=\"collaboration-role role-sales\">Sales</div><div class=\"collaboration-role role-design\">Design</div><div class=\"collaboration-role role-ops\">Operations</div><div class=\"collaboration-role role-owner\">Owner</div>\n  </section>\n\n  <section class=\"collaboration-orbit feature-shell\" id=\"shared-project\">\n    <header class=\"collaboration-section-heading\"><p class=\"feature-kicker\">The connected project</p><h2>Each role sees the context its next decision depends on.</h2><p>Choose a role to see how the same project moves through sales, design, operations, and leadership.</p></header>\n    <div class=\"collaboration-orbit-layout\"><div class=\"team-orbit\"><div class=\"team-core\"><span>PromoPlus</span><b>Custom Bottle Campaign</b><small>Shared project record</small></div><button class=\"team-role team-role-sales is-active\" type=\"button\" data-role=\"sales\"><span>SA</span><b>Sales</b><small>Customer brief</small></button><button class=\"team-role team-role-design\" type=\"button\" data-role=\"design\"><span>DS</span><b>Design</b><small>Artwork + mockup</small></button><button class=\"team-role team-role-ops\" type=\"button\" data-role=\"operations\"><span>OP</span><b>Operations</b><small>Status + handoff</small></button><button class=\"team-role team-role-owner\" type=\"button\" data-role=\"owner\"><span>BO</span><b>Owner</b><small>Visibility</small></button></div><aside class=\"role-story\" aria-live=\"polite\"><p id=\"role-kicker\">Sales view</p><h3 id=\"role-title\">Start with the customer brief.</h3><p id=\"role-copy\">Capture the product, deadline, artwork, and client context once so the project starts clearly.</p><div><span id=\"role-input\">Customer request</span><i>&rarr;</i><b id=\"role-output\">Connected project</b></div></aside></div>\n  </section>\n\n  <section class=\"collaboration-proof\">\n    <div class=\"collaboration-proof-copy\"><p class=\"feature-kicker\">Inside or outside the room</p><h2>The conversation stays attached to the work.</h2><p>Everyone works from the same information, whether they are reviewing artwork together or coordinating with a remote production partner.</p><div class=\"collaboration-proof-outcome\"><small>Customer outcome</small><strong>Improve collaboration across sales, design, and production teams.</strong></div></div>\n    <figure><img src=\"../assets/features/team-collaboration/collaboration-hybrid.png\" alt=\"Sales and design collaborators reviewing artwork with a remote production partner\"><figcaption>One conversation, connected to the exact project.</figcaption></figure>\n    <div class=\"collaboration-benefit-list\" aria-label=\"Team Collaboration benefits\"><article><span>01</span><div><h3>Better communication.</h3><p>Keep discussion beside the work it refers to.</p></div></article><article><span>02</span><div><h3>Fewer internal handoffs.</h3><p>Give every role direct access to the current project.</p></div></article><article><span>03</span><div><h3>Reduced duplicate work.</h3><p>Stop rebuilding context across tools and teams.</p></div></article><article><span>04</span><div><h3>Improved productivity.</h3><p>Move decisions forward with less administrative effort.</p></div></article></div>\n  </section>\n\n  <section class=\"feature-related collaboration-related feature-shell\"><div class=\"feature-section-heading\"><div><p class=\"feature-kicker\">Connected workflow</p><h2>Give the team one place to work and one view of progress.</h2></div></div><div class=\"feature-related-grid\"><a class=\"collaboration-related-link\" href=\"centralized-project-workspace.html\"><small>Shared foundation</small><h3>Centralized Project Workspace</h3><p>Keep every file and decision in one project.</p><span>Explore feature &nearr;</span></a><a class=\"collaboration-related-link\" href=\"workflow-progress-dashboard.html\"><small>Shared visibility</small><h3>Workflow Progress Dashboard</h3><p>See where work is moving and where help is needed.</p><span>Explore feature &nearr;</span></a></div></section>\n  <section class=\"feature-cta collaboration-cta\" id=\"collaboration-cta\"><p class=\"feature-kicker\">Bring the team together</p><h2>Give every role one connected place to move work forward.</h2><div class=\"feature-actions\"><a class=\"feature-primary-action\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan &nearr;</a><a class=\"feature-secondary-action\" href=\"../index.html#journey\">View Workflow &darr;</a></div></section>\n</main>"} />
<Footer variant="feature" label="Team Collaboration" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/script.js"></script>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/team-collaboration.js"></script>
</BaseLayout>



