---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/artwork-version-control.css';
---
<BaseLayout title="Artwork Version Control | PromoPlus" description="Track, compare, and restore every artwork revision with PromoPlus Artwork Version Control." bodyClass="feature-page version-page">
<Header active="features" />
<Fragment set:html={"<main id=\"main-content\">\n  <section class=\"version-hero\">\n    <div class=\"version-hero-image\" aria-hidden=\"true\">\n      <img src=\"../assets/features/version-control/version-control-hero.png\" alt=\"\">\n      <span class=\"proof-chip proof-chip-one\">Original</span>\n      <span class=\"proof-chip proof-chip-two\">Revision</span>\n      <span class=\"proof-chip proof-chip-three\">Approved</span>\n    </div>\n    <div class=\"version-hero-copy\">\n      <p class=\"feature-kicker\">Artwork Version Control</p>\n      <h1>Every revision stays <em>clear.</em></h1>\n      <p class=\"feature-lede\">Every revision is automatically saved. Track changes, compare versions, restore previous artwork, and always know which version was approved.</p>\n      <div class=\"feature-actions\">\n        <a class=\"feature-primary\" href=\"#version-lab\">Compare versions <span aria-hidden=\"true\">↓</span></a>\n        <a class=\"feature-secondary\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span aria-hidden=\"true\">↗</span></a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"version-signal\" aria-label=\"Version control capabilities\">\n    <p>One project record</p>\n    <ul>\n      <li>Automatic saves</li><li>Change history</li><li>Side-by-side comparison</li><li>Restore</li><li>Approved version</li>\n    </ul>\n  </section>\n\n  <section class=\"version-problem feature-shell\">\n    <div class=\"version-problem-heading\">\n      <p class=\"feature-kicker\">The problem with “final”</p>\n      <h2>When versions live in filenames, certainty disappears.</h2>\n    </div>\n    <div class=\"filename-chaos\" aria-hidden=\"true\">\n      <span>design_final.pdf</span>\n      <span>design_final_2.pdf</span>\n      <span>design_FINAL_use-this.pdf</span>\n      <span>design_client-edits.pdf</span>\n      <span>design_latest-new.pdf</span>\n      <strong>Which file was approved?</strong>\n    </div>\n    <p class=\"version-problem-copy\">PromoPlus replaces guesswork with a complete revision record. Each change stays connected to its project, product, and approval history.</p>\n  </section>\n\n  <section class=\"version-lab\" id=\"version-lab\">\n    <div class=\"feature-shell version-lab-heading\">\n      <div><p class=\"feature-kicker\">Interactive version history</p><h2>Compare what changed. Keep what worked.</h2></div>\n      <p>Select a revision to inspect its placement, status, and history. The approved version stays unmistakable.</p>\n    </div>\n    <div class=\"version-lab-stage\">\n      <div class=\"version-stack\" role=\"tablist\" aria-label=\"Artwork versions\">\n        <button class=\"version-card version-one\" type=\"button\" role=\"tab\" aria-selected=\"false\" data-version=\"0\">\n          <span>V1</span><b>First placement</b><small>Original upload</small>\n        </button>\n        <button class=\"version-card version-two\" type=\"button\" role=\"tab\" aria-selected=\"false\" data-version=\"1\">\n          <span>V2</span><b>Logo resized</b><small>Client revision</small>\n        </button>\n        <button class=\"version-card version-three is-active\" type=\"button\" role=\"tab\" aria-selected=\"true\" data-version=\"2\">\n          <span>V3</span><b>Placement refined</b><small>Current version</small>\n        </button>\n        <button class=\"version-card version-approved\" type=\"button\" role=\"tab\" aria-selected=\"false\" data-version=\"3\">\n          <span>✓</span><b>Approved version</b><small>Locked record</small>\n        </button>\n      </div>\n      <article class=\"version-inspector\" aria-live=\"polite\">\n        <div class=\"inspector-top\"><span id=\"inspector-state\">Current version</span><b id=\"inspector-version\">V3</b></div>\n        <div class=\"inspector-art\">\n          <div class=\"inspector-product\"><span id=\"inspector-mark\"></span></div>\n          <div class=\"measure-line measure-horizontal\"></div>\n          <div class=\"measure-line measure-vertical\"></div>\n        </div>\n        <div class=\"inspector-copy\">\n          <p id=\"inspector-note\">Artwork moved slightly upward and aligned to the product center.</p>\n          <dl><div><dt>Changed</dt><dd id=\"inspector-change\">Placement</dd></div><div><dt>Status</dt><dd id=\"inspector-status\">In review</dd></div><div><dt>Source</dt><dd>logo-final.svg</dd></div></dl>\n        </div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"comparison-story feature-shell\">\n    <figure class=\"comparison-figure\">\n      <img src=\"../assets/features/version-control/version-comparison.png\" alt=\"Four organized proof sleeves showing the progression of one tote bag artwork design\">\n      <figcaption><span>V1</span><span>V2</span><span>V3</span><strong>Approved</strong></figcaption>\n    </figure>\n    <div class=\"comparison-copy\">\n      <p class=\"feature-kicker\">A visible change trail</p>\n      <h2>See the evolution—not another pile of files.</h2>\n      <p>Every saved version keeps the artwork, placement, and revision context that created it.</p>\n      <ul>\n        <li><b>Track changes</b><span>Understand how artwork moved from one revision to the next.</span></li>\n        <li><b>Compare versions</b><span>Review the differences before choosing what moves forward.</span></li>\n        <li><b>Restore previous artwork</b><span>Return to an earlier direction without rebuilding the proof.</span></li>\n      </ul>\n    </div>\n  </section>\n\n  <section class=\"approved-lock\">\n    <div class=\"approved-lock-image\"><img src=\"../assets/features/version-control/approved-version-lock.png\" alt=\"Final approved cap proof secured in a clear sleeve while older versions recede behind it\"></div>\n    <div class=\"approved-lock-copy\">\n      <p class=\"feature-kicker\">Approved means identified</p>\n      <h2>Always know which version was approved.</h2>\n      <p>The selected proof moves forward with a clear status while older revisions remain available in the project history.</p>\n      <div class=\"lock-status\"><span aria-hidden=\"true\">✓</span><div><small>Approved version</small><b>Protected from confusion</b></div></div>\n    </div>\n  </section>\n\n  <section class=\"version-benefits feature-shell\">\n    <div class=\"benefit-intro\"><p class=\"feature-kicker\">Benefits</p><h2>Control that protects every handoff.</h2></div>\n    <div class=\"version-benefit-grid\">\n      <article><span>01</span><h3>Eliminate confusion.</h3><p>Give every revision a clear place in the project history.</p></article>\n      <article><span>02</span><h3>Prevent production mistakes.</h3><p>Keep the approved version visible before files move forward.</p></article>\n      <article><span>03</span><h3>Improve accountability.</h3><p>See what changed and preserve the context behind each revision.</p></article>\n      <article><span>04</span><h3>Maintain a complete audit trail.</h3><p>Retain the sequence from original artwork to approved proof.</p></article>\n    </div>\n  </section>\n\n  <section class=\"version-outcome feature-shell\">\n    <p class=\"feature-kicker\">Customer outcome</p>\n    <h2>Eliminate confusion caused by multiple artwork versions.</h2>\n    <p>Sales, design, and production can move forward from the same approved record.</p>\n  </section>\n\n  <section class=\"related-features feature-shell\">\n    <p class=\"feature-kicker\">Connected features</p>\n    <div class=\"related-grid\">\n      <a class=\"version-related-link\" href=\"online-mockup-designer.html\"><small>Create each revision in</small><h3>Online Mockup Designer</h3><p>Place, resize, rotate, and preview artwork in the browser.</p><span>Explore feature ↗</span></a>\n      <a class=\"version-related-link\" href=\"centralized-project-workspace.html\"><small>Keep revision context in</small><h3>Centralized Project Workspace</h3><p>Store products, artwork, notes, and project history together.</p><span>Explore feature ↗</span></a>\n    </div>\n  </section>\n\n  <section class=\"feature-final-cta\" id=\"version-cta\">\n    <div><p class=\"feature-kicker\">Keep every revision clear</p><h2>Ready to stop guessing which file is final?</h2></div>\n    <a class=\"feature-primary\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span aria-hidden=\"true\">↗</span></a>\n  </section>\n</main>"} />
<Footer variant="feature" label="Artwork Version Control" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/artwork-version-control.js"></script>
</BaseLayout>



