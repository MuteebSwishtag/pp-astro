---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/legacy/promo-base.css';
import '../../styles/legacy/feature-page.css';
import '../../styles/feature-cursor.css';
import '../../styles/legacy/workflow-progress-dashboard.css';
---
<BaseLayout title="Workflow Progress Dashboard | PromoPlus" description="Track every artwork project from creation to production with the PromoPlus Workflow Progress Dashboard." bodyClass="feature-page dashboard-page">
<Header active="features" />
<Fragment set:html={"<main id=\"main-content\">\n  <section class=\"dashboard-hero\">\n    <div class=\"dashboard-hero-copy\">\n      <p class=\"feature-kicker\">Workflow Progress Dashboard</p>\n      <h1>See every project. <strong>Move the right work forward.</strong></h1>\n      <p class=\"feature-lede\">Track every artwork project from creation to production. Business owners always know where work is moving and where it is blocked.</p>\n      <div class=\"feature-actions\"><a class=\"feature-primary-action\" href=\"#live-dashboard\">Explore the dashboard <span>&darr;</span></a><a class=\"feature-secondary-action\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan <span>&nearr;</span></a></div>\n      <div class=\"dashboard-hero-states\" aria-label=\"Project stages\"><span>Artwork</span><span>Approval</span><span>Revision</span><span>Production</span></div>\n    </div>\n    <figure class=\"dashboard-hero-image\"><img src=\"../assets/features/workflow-dashboard/dashboard-hero.png\" alt=\"Operations team reviewing promotional-product project statuses on a large display\"><figcaption><b>One live view</b><span>Artwork &rarr; Approval &rarr; Production</span></figcaption></figure>\n  </section>\n\n  <section class=\"dashboard-live feature-shell\" id=\"live-dashboard\">\n    <header class=\"dashboard-section-heading\"><p class=\"feature-kicker\">Live operational view</p><h2>One view shows what is moving, waiting, and ready.</h2><p>Filter the workflow by stage and focus the team on the projects that need a decision now.</p></header>\n    <div class=\"dashboard-live-layout\">\n      <div class=\"dashboard-board\">\n        <div class=\"board-top\"><b>Artwork workflow</b><span id=\"board-total\">12 active projects</span></div>\n        <div class=\"board-filters\" role=\"tablist\" aria-label=\"Filter project status\"><button class=\"is-active\" type=\"button\" data-status=\"all\" role=\"tab\" aria-selected=\"true\">All</button><button type=\"button\" data-status=\"artwork\" role=\"tab\" aria-selected=\"false\">Artwork</button><button type=\"button\" data-status=\"approval\" role=\"tab\" aria-selected=\"false\">Approval</button><button type=\"button\" data-status=\"revision\" role=\"tab\" aria-selected=\"false\">Revisions</button><button type=\"button\" data-status=\"production\" role=\"tab\" aria-selected=\"false\">Production</button></div>\n        <div class=\"board-columns\">\n          <article data-column=\"artwork\"><header><span></span><b>Pending artwork</b><i>03</i></header><div class=\"project-card\"><small>Northline event</small><b>Bottle campaign</b><span>Artwork due today</span></div><div class=\"project-card\"><small>Spring launch</small><b>Canvas tote</b><span>Source file missing</span></div></article>\n          <article data-column=\"approval\"><header><span></span><b>Awaiting approval</b><i>04</i></header><div class=\"project-card\"><small>Retail opening</small><b>Staff hoodie</b><span>Client link opened</span></div><div class=\"project-card\"><small>Conference kit</small><b>Travel mug</b><span>Waiting 1 day</span></div></article>\n          <article data-column=\"revision\"><header><span></span><b>Revision requests</b><i>02</i></header><div class=\"project-card\"><small>Member campaign</small><b>Embroidered cap</b><span>Logo size change</span></div><div class=\"project-card\"><small>Summer team</small><b>Performance tee</b><span>Version 3 requested</span></div></article>\n          <article data-column=\"production\"><header><span></span><b>Production ready</b><i>03</i></header><div class=\"project-card\"><small>Annual meeting</small><b>Welcome bundle</b><span>PDF generated</span></div><div class=\"project-card\"><small>Client gifting</small><b>Desk set</b><span>Approved today</span></div></article>\n        </div>\n      </div>\n      <aside class=\"dashboard-insight\"><p>Current focus</p><span id=\"insight-count\">12</span><h3 id=\"insight-title\">Every active project</h3><p id=\"insight-copy\">See the complete artwork workload and identify the next decision.</p><div><i></i><small>Live project visibility</small></div></aside>\n    </div>\n  </section>\n\n  <section class=\"dashboard-proof\">\n    <div class=\"dashboard-proof-copy\"><p class=\"feature-kicker\">From visibility to action</p><h2>Catch the block before it becomes a delay.</h2><p>Instantly identify pending artwork, approval requests, revisions, approved work, and production-ready projects.</p><div class=\"dashboard-proof-outcome\"><small>Customer outcome</small><strong>Increase operational visibility without increasing administrative overhead.</strong></div></div>\n    <figure><img src=\"../assets/features/workflow-dashboard/dashboard-visibility.png\" alt=\"Business owner checking project status while production orders are prepared\"><figcaption>One current status, shared from the office to the production floor.</figcaption></figure>\n    <div class=\"dashboard-benefit-list\" aria-label=\"Workflow Progress Dashboard benefits\"><article><span>01</span><div><h3>Complete operational visibility.</h3><p>See every active project and its current stage.</p></div></article><article><span>02</span><div><h3>Faster decision-making.</h3><p>Act on the project that needs attention now.</p></div></article><article><span>03</span><div><h3>Better workload management.</h3><p>Balance work across artwork, approvals, and production.</p></div></article><article><span>04</span><div><h3>Reduced project delays.</h3><p>Catch blocked work before deadlines slip.</p></div></article></div>\n  </section>\n\n  <section class=\"feature-related dashboard-related feature-shell\"><div class=\"feature-section-heading\"><div><p class=\"feature-kicker\">Connected workflow</p><h2>Visibility works better when the work stays connected.</h2></div></div><div class=\"feature-related-grid\"><a class=\"dashboard-related-link\" href=\"centralized-project-workspace.html\"><small>Organize first</small><h3>Centralized Project Workspace</h3><p>Keep every project record together.</p><span>Explore feature &nearr;</span></a><a class=\"dashboard-related-link\" href=\"team-collaboration.html\"><small>Move together</small><h3>Team Collaboration</h3><p>Give every role the same current information.</p><span>Explore feature &nearr;</span></a></div></section>\n  <section class=\"feature-cta dashboard-cta\" id=\"dashboard-cta\"><p class=\"feature-kicker\">See the whole workflow</p><h2>Know what is moving before anyone has to ask.</h2><div class=\"feature-actions\"><a class=\"feature-primary-action\" href=\"/pricing.html#custom-plan-form\">Request Custom Plan &nearr;</a><a class=\"feature-secondary-action\" href=\"../index.html#journey\">View Workflow &darr;</a></div></section>\n</main>"} />
<Footer variant="feature" label="Workflow Progress Dashboard" top="#main-content" />
<div class="cursor" aria-hidden="true"><span class="cursor-ring"><span class="cursor-label"></span></span><span class="cursor-dot"></span></div>
<script is:inline src="/script.js"></script>
<script is:inline src="/features/feature-page.js"></script>
<script is:inline src="/features/workflow-progress-dashboard.js"></script>
</BaseLayout>



