---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FAQ from '../components/FAQ.astro';
import PricingPlans from '../components/PricingPlans.astro';
import HomeSections from '../components/HomeSections.astro';
import ChromeEffects from '../components/ChromeEffects.astro';
import HeroPreviewScript from '../components/HeroPreviewScript.astro';
import '../styles/legacy/homepage.css';
import '../styles/legacy/home-inline.css';
import '../styles/legacy/pricing-page.css';
---
<BaseLayout title="PromoPlus — Product approvals, made clear" description="PromoPlus — promotional product approval workflows.">
  <Header active="home" />
  <main id="top">
    <HomeSections />
    <PricingPlans />
    <FAQ />
  </main>
  <Footer />
  <ChromeEffects />
  <script is:inline src="/homepage.js"></script>
  <script is:inline src="/custom-plan.js"></script>
  <HeroPreviewScript />
</BaseLayout>

