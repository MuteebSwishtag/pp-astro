---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/legacy/homepage.css';
import '../styles/legacy/navigation.css';
import '../styles/legacy/contact.css';
---
<BaseLayout title="Contact PromoPlus | Talk to Our Team" description="Tell us what you want to improve: custom plans, product workflow or approval setup. The PromoPlus team will get back to you shortly." bodyClass="contact-page">
  <Header active="contact" />
  <main id="top">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="contact-copy">
        <p class="eyebrow">Contact us</p>
        <h1 id="contact-title">Talk with the PromoPlus team.</h1>
        <p>Tell us what you are trying to improve. We will route your message to the right person and get back to you shortly.</p>
        <div class="contact-signals" aria-label="Common reasons to contact PromoPlus">
          <span>Custom plans</span>
          <span>Product workflow</span>
          <span>Approval setup</span>
        </div>
      </div>

      <div class="contact-panel">
        <form class="contact-form" id="contact-form" action="/contact.php" method="post" data-endpoint="/contact.php">
          <input type="hidden" name="inquiry_type" value="Contact Form">
          <input type="text" name="website" value="" tabindex="-1" autocomplete="off" hidden aria-hidden="true">
          <div class="contact-fields">
            <div class="contact-field">
              <label for="contact-name">Full name <span aria-hidden="true">*</span></label>
              <input id="contact-name" name="name" autocomplete="name" required>
            </div>
            <div class="contact-field">
              <label for="contact-email">Work email <span aria-hidden="true">*</span></label>
              <input id="contact-email" name="email" type="email" autocomplete="email" required>
            </div>
            <div class="contact-field">
              <label for="contact-company">Company</label>
              <input id="contact-company" name="company" autocomplete="organization">
            </div>
            <div class="contact-field">
              <label for="contact-phone">Phone</label>
              <input id="contact-phone" name="phone" type="tel" autocomplete="tel">
            </div>
            <div class="contact-field contact-field-wide">
              <label for="contact-message">How can we help? <span aria-hidden="true">*</span></label>
              <textarea id="contact-message" name="message" rows="6" placeholder="Share a little about your workflow, team size, products, or what you want to see in PromoPlus." required></textarea>
            </div>
          </div>
          <button type="submit">Send Message</button>
          <p class="contact-note">Your message will use the same secure routing as PromoPlus sales requests.</p>
          <p class="contact-message" role="status" aria-live="polite" hidden></p>
        </form>
        <div class="contact-success" role="status" tabindex="-1" hidden>
          <span aria-hidden="true">✓</span>
          <h2>Message received.</h2>
          <p>Thanks for reaching out. We will get back to you shortly.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="/contact-form.js"></script>
</BaseLayout>
