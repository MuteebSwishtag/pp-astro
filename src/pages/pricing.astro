---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingPlans from '../components/PricingPlans.astro';
import SchemaFaq from '../components/SchemaFaq.astro';
import pageSchema from '../data/pageSchema.json';
import '../styles/legacy/homepage.css';
import '../styles/legacy/navigation.css';
import '../styles/legacy/pricing-page.css';
const pricingFaq = pageSchema['/pricing']['@graph'].find((node) => node['@type'] === 'FAQPage') as {
  mainEntity: Array<{ name: string; acceptedAnswer: { text: string } }>;
};
---
<BaseLayout title="Pricing | PromoPlus" description="Compare PromoPlus Starter, Pro, and Custom plans." bodyClass="pricing-page">
  <Header active="pricing" />
  <main id="top">
    <PricingPlans />
    <SchemaFaq faq={pricingFaq} title="Questions about PromoPlus pricing" description="Answers about production files, free trials, plan limits, and integrations." />
  </main>
  <Footer />
  <script is:inline src="/custom-plan.js"></script>
</BaseLayout>

