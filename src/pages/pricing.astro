---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingPlans from '../components/PricingPlans.astro';
import FAQ from '../components/FAQ.astro';
import pageSchema from '../data/pageSchema.json';
import '../styles/legacy/homepage.css';
import '../styles/legacy/navigation.css';
import '../styles/legacy/pricing-page.css';
const pricingFaq = pageSchema['/pricing']['@graph'].find((node) => node['@type'] === 'FAQPage') as {
  mainEntity: Array<{ name: string; acceptedAnswer: { text: string } }>;
};
---
<BaseLayout title="Pricing: Promo Mockup and Approval Software | PromoPlus" description="Starter at $30/month with a 30-day free trial, Pro at $100/month, or a custom plan. Starter and Pro include unlimited mockups and online approvals." bodyClass="pricing-page">
  <Header active="pricing" />
  <main id="top">
    <PricingPlans eyebrow="Simple pricing for promo mockups and approvals" />
    <FAQ items={pricingFaq.mainEntity.map((entry) => [entry.name, entry.acceptedAnswer.text] as const)} title="Questions about PromoPlus pricing" description="Answers about production files, free trials, plan limits, and integrations." />
  </main>
  <Footer />
  <script is:inline src="/custom-plan.js"></script>
</BaseLayout>

