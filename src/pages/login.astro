---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/legacy/auth.css';
---
<BaseLayout title="Log in | PromoPlus" description="Log in to your PromoPlus account." bodyClass="">
<Fragment set:html={"<main class=\"auth-page\"><div class=\"auth-shell\"><a class=\"auth-brand\" href=\"/\" aria-label=\"PromoPlus home\"><span class=\"auth-brand-mark\" aria-hidden=\"true\">+</span>Promo<span>Plus</span></a><section class=\"auth-card\" aria-labelledby=\"auth-title\"><h1 id=\"auth-title\">Welcome back</h1><p class=\"auth-subtitle\">Log in to continue to PromoPlus.</p>\n<div class=\"auth-social\" aria-label=\"Social sign-in options\"><button type=\"button\" data-provider=\"Google\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#4285F4\" d=\"M21.6 12.23c0-.68-.06-1.36-.18-2.02H12v3.83h5.38a4.61 4.61 0 0 1-2 3.03v2.48h3.24c1.9-1.75 2.98-4.33 2.98-7.32Z\"/><path fill=\"#34A853\" d=\"M12 22c2.7 0 4.97-.9 6.62-2.45l-3.24-2.48c-.9.61-2.05.97-3.38.97-2.6 0-4.8-1.75-5.6-4.1H3.06v2.57A10 10 0 0 0 12 22Z\"/><path fill=\"#FBBC05\" d=\"M6.4 13.94a6.02 6.02 0 0 1 0-3.88V7.49H3.06a10 10 0 0 0 0 9.02l3.34-2.57Z\"/><path fill=\"#EA4335\" d=\"M12 5.96c1.43 0 2.72.49 3.73 1.46l2.87-2.87A9.57 9.57 0 0 0 12 2a10 10 0 0 0-8.94 5.49l3.34 2.57c.8-2.35 3-4.1 5.6-4.1Z\"/></svg>Continue with Google</button><button type=\"button\" data-provider=\"Apple\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M17.05 12.54c.02 2.12 1.85 2.83 1.87 2.84-.01.05-.29 1.03-.97 2.03-.59.86-1.2 1.72-2.17 1.74-.95.02-1.26-.56-2.35-.56-1.09 0-1.43.54-2.33.58-.94.03-1.65-.94-2.24-1.79-1.22-1.76-2.14-4.99-.9-7.16a3.46 3.46 0 0 1 2.93-1.78c.92-.02 1.79.62 2.35.62.55 0 1.58-.76 2.67-.65a3.37 3.37 0 0 1 2.56 1.39 3.28 3.28 0 0 0-1.42 2.74ZM15.2 7.27a3.4 3.4 0 0 0 .78-2.47c-.87.04-1.93.58-2.56 1.3a3.27 3.27 0 0 0-.8 2.39c.97.07 1.95-.49 2.58-1.22Z\"/></svg>Continue with Apple</button><button type=\"button\" data-provider=\"Facebook\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"#1877F2\" d=\"M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.5-3.9 3.78-3.9 1.1 0 2.25.2 2.25.2v2.47H15.2c-1.25 0-1.64.78-1.64 1.57V12h2.79l-.45 2.89h-2.34v6.99A10 10 0 0 0 22 12Z\"/><path fill=\"#fff\" d=\"m15.9 14.89.45-2.89h-2.79v-1.87c0-.79.39-1.57 1.64-1.57h1.27V6.09s-1.15-.2-2.25-.2c-2.28 0-3.78 1.39-3.78 3.9V12H7.9v2.89h2.54v6.99a10.1 10.1 0 0 0 3.12 0v-6.99h2.34Z\"/></svg>Continue with Facebook</button></div>\n<div class=\"auth-divider\" aria-hidden=\"true\">OR</div><form class=\"auth-form\" novalidate><div class=\"auth-field\"><label for=\"email\">Email</label><input id=\"email\" name=\"email\" type=\"email\" autocomplete=\"username\" placeholder=\"you@company.com\" required aria-describedby=\"email-error\"><span class=\"auth-error\" id=\"email-error\" aria-live=\"polite\"></span></div><div class=\"auth-field\"><label for=\"password\">Password</label><div class=\"auth-input-wrap auth-password\"><input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"current-password\" placeholder=\"Enter your password\" required aria-describedby=\"password-error\"><button class=\"auth-visibility\" type=\"button\" aria-controls=\"password\" aria-label=\"Show password\">Show</button></div><span class=\"auth-error\" id=\"password-error\" aria-live=\"polite\"></span></div><div class=\"auth-form-extra\"><button class=\"auth-text-button\" type=\"button\" data-recovery>Forgot password?</button></div><button class=\"auth-submit\" type=\"submit\">Log in</button><p class=\"auth-status\" aria-live=\"polite\"></p></form><p class=\"auth-switch\">Don't have an account? <a href=\"/signup\">Sign up</a></p></section><p class=\"auth-footer\">© PromoPlus</p></div></main><script is:inline src=\"auth.js\"></script>"} />
<script is:inline src="/auth.js"></script>
</BaseLayout>

