# PromoPlus MySQL connection for PHP endpoints on Hostinger.
# Hostinger PHP apps should connect to MySQL through localhost/127.0.0.1.
PP_DB_HOST=127.0.0.1
PP_DB_PORT=3306
PP_DB_NAME=your_database_name
PP_DB_USER=your_database_user
PP_DB_PASS=your_database_password
PP_DB_CHARSET=utf8mb4

# Admin login for /admin/.
PP_ADMIN_USER=your_admin_name
PP_ADMIN_PASS=your_admin_password

# Optional: use a password hash instead of PP_ADMIN_PASS.
# Generate with: php -r "echo password_hash('your_admin_password', PASSWORD_DEFAULT);"
# PP_ADMIN_PASS_HASH=
